{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carr-production-proof-plan.v1",
  "description": "Admission only. Acceptance never attests execution or authorizes completion.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "requirement_id", "targets", "assertions", "safety"],
  "properties": {
    "schema": {"enum": ["carr-production-proof-plan.v1"]},
    "requirement_id": {"type": "string", "minLength": 3, "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]+$"},
    "targets": {
      "type": "array", "minItems": 1, "maxItems": 3,
      "items": {"enum": ["worker", "app", "studio"]}
    },
    "assertions": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "predicate", "runner", "expected_result", "input_class", "deadline_seconds"],
        "properties": {
          "id": {"type": "string", "minLength": 3},
          "predicate": {"type": "string", "minLength": 12},
          "runner": {"type": "string", "minLength": 3},
          "expected_result": {"type": "string", "minLength": 8},
          "input_class": {"type": "string", "minLength": 3},
          "deadline_seconds": {"type": "integer", "minimum": 1, "maximum": 300}
        }
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["read_only", "no_sends", "max_requests", "max_records", "max_runtime_seconds", "max_artifact_bytes"],
      "properties": {
        "read_only": {"enum": [true]},
        "no_sends": {"enum": [true]},
        "max_requests": {"type": "integer", "minimum": 1, "maximum": 100},
        "max_records": {"type": "integer", "minimum": 1, "maximum": 1000},
        "max_runtime_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
        "max_artifact_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576}
      }
    }
  },
  "x-runner-source-binding": "Registry CI validates either an ancestor revision/path or a sources map of repository-local paths to SHA256 at tested HEAD. Content bindings include the entry path and its local dependency closure; squash preserves their identity. Never fall back from a refused revision. Neither binding attests installation or execution.",
  "x-runners": {
    "app-release-live-walk.v1": {
      "path": "ops/app-proof-observe.py",
      "revision": "55d0bd0cb7cc18f651eb4f2569aa111749032369",
      "targets": ["app"]
    },
    "worker-release-smoke.v1": {
      "path": "ops/release-smoke.py",
      "revision": "8bdabfe3275668cd10401a8e58244b953d3d2428",
      "targets": ["worker"]
    },
    "studio-canonical-run.v1": {
      "path": "ops/studio-proof-observe.py",
      "targets": [
        "studio"
      ],
      "sources": {
        "ops/studio-proof-observe.py": "2de3fadf40d11b38dbea2a7425f37e1d74fa53c2550fa737bd0e2cd677552858",
        "lib/studio_proof.py": "ac765ddbfde7c2ea5a7c58507898ac693e5502d65dbdc1f748997d3cc303e571",
        "tools/ops-record.py": "1ab49d2f330c6be053d3bc07819778e5f32efc7411636c58f7b0dedaa726a7c2",
        "lib/credential_file.py": "68c27169405b12a9a41b94d3de6aa94b66eec324b8971e12c0ebc9228456919b"
      }
    },
    "studio-run-receipt.v1": {"path": "ops/studio-proof-observe.py", "revision": "f699e1859dc87e4122501bbaba35a312607452a7", "targets": ["studio"]}
  },
  "x-required-targets": {"worker": ["mcp-server/**", "migrations/**"], "studio": ["lib/outlook*.py", "bin/install-outlook-*", "bin/refresh-outlook-runtime", "ops/launchd/com.carr.outlook-*.plist"]},
  "x-non-product-paths": [
    "docs/**", "test/**", "mcp-server/test/**", "README.md",
    ".github/**", "ops/*-selftest.py", "tools/test-*.py", "tools/test_*.py",
