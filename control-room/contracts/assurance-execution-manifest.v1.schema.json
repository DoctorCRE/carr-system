{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carr-assurance-execution-manifest-v1",
  "contract": "carr-assurance-execution-manifest",
  "version": "1.0.0",
  "x-carr-foundation-revision": "1.1.0",
  "status": "phase1_contract_foundation_not_deployed",
  "description": "Immutable compiler output. It proves deterministic binding and declared-window consistency only; it is never action authority, live-currentness proof, or verification.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "compiler",
    "authority_state",
    "verification_state",
    "self_certification",
    "input_digest",
    "input_bindings",
    "slice",
    "currentness",
    "refusal_vocabulary",
    "manifest_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "assurance-execution-manifest.v1"
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "const": "carr-assurance-slice-compiler"
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "authority_state": {
      "const": "compiled_not_authorized"
    },
    "verification_state": {
      "const": "unverified"
    },
    "self_certification": {
      "const": false
    },
    "input_digest": {
      "$ref": "#/$defs/Digest"
    },
    "input_bindings": {
      "$ref": "#/$defs/InputBindings"
    },
    "slice": {
      "$ref": "#/$defs/Slice"
    },
    "currentness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_phase",
        "authorizes_action",
        "currentness_state",
        "live_currentness_verified",
        "declared_evaluation_time",
        "snapshot_as_of",
        "snapshot_valid_until",
        "lease_expires_at",
        "usable_only_as_preflight_for",
        "requires_live_currentness_check_before",
        "recompile_against_resulting_commit_tree_before"
      ],
      "properties": {
        "manifest_phase": {
          "const": "baseline"
        },
        "authorizes_action": {
          "const": false
        },
        "currentness_state": {
          "const": "declared_window_consistent_not_live_verified"
        },
        "live_currentness_verified": {
          "const": false
        },
        "declared_evaluation_time": {
          "$ref": "#/$defs/Timestamp"
        },
        "snapshot_as_of": {
          "$ref": "#/$defs/Timestamp"
        },
        "snapshot_valid_until": {
          "$ref": "#/$defs/Timestamp"
        },
        "lease_expires_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "usable_only_as_preflight_for": {
          "const": []
        },
        "requires_live_currentness_check_before": {
          "const": [
            "write",
            "test",
            "commit",
            "push",
            "pr_update",
            "review",
            "merge",
            "runtime_action"
          ]
        },
        "recompile_against_resulting_commit_tree_before": {
          "const": [
            "commit",
            "push",
            "pr_update",
            "review",
            "merge",
            "runtime_action"
          ]
        }
      }
    },
    "refusal_vocabulary": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "manifest_hash": {
      "$ref": "#/$defs/Digest"
    }
  },
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "InputBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "work_request",
        "accepted_plan_revision",
        "engineering_slice_plan_digest",
        "assurance_slice_ownership_contract_digest",
        "assurance_slice_contract_digest",
        "repository",
        "applicable_rule_snapshot_digest",
        "coordination_snapshot_digest"
      ],
      "properties": {
        "work_request": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/WorkBinding"
        },
        "accepted_plan_revision": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/PlanBinding"
        },
        "engineering_slice_plan_digest": {
          "$ref": "#/$defs/Digest"
        },
        "assurance_slice_ownership_contract_digest": {
          "$ref": "#/$defs/Digest"
        },
        "assurance_slice_contract_digest": {
          "$ref": "#/$defs/Digest"
        },
        "repository": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Repository"
        },
        "applicable_rule_snapshot_digest": {
          "$ref": "#/$defs/Digest"
        },
        "coordination_snapshot_digest": {
          "$ref": "#/$defs/Digest"
        }
      }
    },
    "Slice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_ref",
        "objective",
        "outcome",
        "risk",
        "allowed_paths",
        "forbidden_paths",
        "dependency_gates",
        "required_tests",
        "evidence_requirements",
        "reviewer_policy",
        "observable_output",
        "rollback",
        "release_class",
        "unfinished_work",
        "lease_binding",
        "executor_identity"
      ],
      "properties": {
        "slice_ref": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "$ref": "#/$defs/Risk"
        },
        "allowed_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "assurance-slice-contract.v1.schema.json#/$defs/PathClaim"
          },
          "uniqueItems": true
        },
        "forbidden_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "assurance-slice-contract.v1.schema.json#/$defs/ForbiddenPath"
          },
          "uniqueItems": true
        },
        "dependency_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/DependencyGate"
          }
        },
        "required_tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "assurance-slice-contract.v1.schema.json#/$defs/RequiredTest"
          },
          "uniqueItems": true
        },
        "evidence_requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/EvidenceRequirement"
          }
        },
        "reviewer_policy": {
          "$ref": "#/$defs/ReviewerPolicy"
        },
        "observable_output": {
          "$ref": "#/$defs/ObservableOutput"
        },
        "rollback": {
          "$ref": "#/$defs/Rollback"
        },
        "release_class": {
          "enum": [
            "none",
            "repository_only",
            "runtime",
            "production"
          ]
        },
        "unfinished_work": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "lease_binding": {
          "$ref": "#/$defs/LeaseBinding"
        },
        "executor_identity": {
          "$ref": "#/$defs/ExecutorIdentity"
        }
      }
    },
    "Timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:[1-9]\\d{3})-(?:01|03|05|07|08|10|12)-(?:0[1-9]|[12]\\d|3[01])|(?:[1-9]\\d{3})-(?:04|06|09|11)-(?:0[1-9]|[12]\\d|30)|(?:[1-9]\\d{3})-02-(?:0[1-9]|1\\d|2[0-8])|(?:(?:[1-9]\\d(?:0[48]|[2468][048]|[13579][26])|(?:[2468][048]|[3579][26])00)-02-29))T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$"
    },
    "Risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "risk_class",
        "summary"
      ],
      "properties": {
        "risk_class": {
          "enum": [
            "R0",
            "R1",
            "R2",
            "R3",
            "R4",
            "R5",
            "R6"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "DependencyGate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slice_ref",
        "required_state"
      ],
      "properties": {
        "slice_ref": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        },
        "required_state": {
          "enum": [
            "completed",
            "independently_verified"
          ]
        }
      }
    },
    "EvidenceRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_ref",
        "artifact_kind",
        "required_fields"
      ],
      "properties": {
        "evidence_ref": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        },
        "artifact_kind": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        },
        "required_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "ReviewerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_independent_reviewers",
        "executor_actor_ref",
        "executor_session_ref",
        "owner_acceptance_is_review",
        "distinct_actor_and_session"
      ],
      "properties": {
        "minimum_independent_reviewers": {
          "type": "integer",
          "minimum": 1
        },
        "executor_actor_ref": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        },
        "executor_session_ref": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        },
        "owner_acceptance_is_review": {
          "const": false
        },
        "distinct_actor_and_session": {
          "const": true
        }
      }
    },
    "ObservableOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "evidence_ref"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidence_ref": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        }
      }
    },
    "Rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "argv",
        "cwd",
        "observable_success"
      ],
      "properties": {
        "strategy": {
          "type": "string",
          "minLength": 1
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cwd": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/RepoPath"
        },
        "observable_success": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "LeaseBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lease_id",
        "fencing_generation",
        "holder_session_id",
        "holder_host_id"
      ],
      "properties": {
        "lease_id": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        },
        "fencing_generation": {
          "type": "integer",
          "minimum": 1
        },
        "holder_session_id": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        },
        "holder_host_id": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        }
      }
    },
    "ExecutorIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actor_ref",
        "session_ref",
        "host_ref"
      ],
      "properties": {
        "actor_ref": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        },
        "session_ref": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        },
        "host_ref": {
          "$ref": "assurance-slice-contract.v1.schema.json#/$defs/Id"
        }
      }
    }
  }
}
