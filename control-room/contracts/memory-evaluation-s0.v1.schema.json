      "required": ["work_request_id", "state_version", "canonical_record_digest", "accepted_resource_revisions"],
      "properties": {
        "work_request_id": {"const": "wr:7225c61a-324b-46b4-a234-8aff42f831fd"},
        "state_version": {"const": 3},
        "canonical_record_digest": {"const": "sha256:7d3e18d350d0241af9e060fa336fb978b97b5053629a4c60b1a04a09e51b680c"},
