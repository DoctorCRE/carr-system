{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "carr://control-room/contracts/memory-evaluation-s0.v1.schema.json",
  "version": "1.0.0",
  "status": "phase0_frozen_contracts_only",
  "title": "CARR memory evaluation S0 frozen baseline",
  "description": "Synthetic-only source, evaluation, threat, cost, gap, legacy-route, and acceptance-evidence baseline. It calls no model, writes no record, changes no production behavior, and grants no memory or policy authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "version",
    "status",
    "data_class",
    "calls_models",
    "writes_records",
    "production_behavior_changes",
    "binding",
    "record_state_binding",
    "resource_bindings",
    "gate_registry",
    "source_lock",
    "memory_evaluation_contract",
    "synthetic_scope_fixtures",
    "threat_model",
    "cost_latency_storage_model",
    "current_gap_legacy_inventory",
    "acceptance_evidence_matrix",
    "forbidden_changes",
    "artifact_digest"
  ],
  "properties": {
    "schema_version": {"const": "memory-evaluation-s0.v1"},
    "version": {"const": "1.0.0"},
    "status": {"const": "frozen_contracts_only"},
    "data_class": {"const": "synthetic_only"},
    "calls_models": {"const": false},
    "writes_records": {"const": false},
    "production_behavior_changes": {"const": false},
    "binding": {"$ref": "#/$defs/binding"},
    "record_state_binding": {"$ref": "#/$defs/record_state_binding"},
    "resource_bindings": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "x-carr-unique-by": "resource_ref",
      "items": {"$ref": "#/$defs/resource_binding"}
    },
    "gate_registry": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "x-carr-unique-by": "gate_ref",
      "items": {"$ref": "#/$defs/gate"}
