    "source_lock": {"$ref": "#/$defs/source_lock"},
    "memory_evaluation_contract": {"$ref": "#/$defs/evaluation"},
    "synthetic_scope_fixtures": {"$ref": "#/$defs/scope_fixtures"},
    "threat_model": {"$ref": "#/$defs/threat_model"},
    "cost_latency_storage_model": {"$ref": "#/$defs/cost_model"},
    "current_gap_legacy_inventory": {
      "type": "array",
      "minItems": 8,
      "maxItems": 20,
      "x-carr-unique-by": "inventory_id",
      "items": {"$ref": "#/$defs/gap_inventory"}
