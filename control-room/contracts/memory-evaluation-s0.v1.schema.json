    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "case_set_digest"],
      "properties": {
        "name": {"enum": ["development", "tuning", "held_out", "temporal_holdout", "prospective_non_derivation"]},
        "case_set_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "suite": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id"],
      "properties": {"suite_id": {"enum": ["held_out_real", "temporal", "adversarial", "accumulation", "outage", "public_directional", "exact_vs_ann", "lexical_degraded"]}}
    },
    "labels": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjudication"],
      "properties": {"adjudication": {"type": "array", "minItems": 5, "maxItems": 30, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 100}}}
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "formula", "threshold", "bound_action", "failure_action"],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]{2,80}$"},
        "formula": {"type": "string", "minLength": 8, "maxLength": 1000},
        "threshold": {"type": "string", "minLength": 2, "maxLength": 300},
        "bound_action": {"type": "string", "minLength": 8, "maxLength": 500},
        "failure_action": {"enum": ["block_release", "pause_canary", "degrade_lexical", "require_review", "report_only"]}
      }
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "bootstrap_iterations", "random_seed", "threshold"],
      "properties": {
        "method": {"type": "string", "minLength": 8, "maxLength": 200},
        "bootstrap_iterations": {"type": "integer", "minimum": 1000, "maximum": 100000},
        "random_seed": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "threshold": {"type": "string", "minLength": 3, "maxLength": 200}
      }
    },
    "model_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answerer", "judge", "embedding", "reranker", "extractor"],
      "properties": {
        "answerer": {"$ref": "#/$defs/nonempty"},
        "judge": {"$ref": "#/$defs/nonempty"},
        "embedding": {"$ref": "#/$defs/nonempty"},
        "reranker": {"$ref": "#/$defs/nonempty"},
        "extractor": {"$ref": "#/$defs/nonempty"}
      }
    },
    "outcome_horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["horizon_id", "window", "state"],
      "properties": {
        "horizon_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{2,80}$"},
        "window": {"type": "string", "minLength": 2, "maxLength": 100},
        "state": {"enum": ["not_measured", "measured", "unavailable", "stale"]}
      }
    },
    "measurement_units": {
      "type": "object",
      "additionalProperties": false,
      "required": ["latency", "cost", "storage", "tokens"],
      "properties": {
        "latency": {"const": "milliseconds"},
        "cost": {"const": "usd"},
        "storage": {"const": "bytes"},
        "tokens": {"const": "model_tokens"}
      }
    },
    "evaluation_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "split", "suite_ids", "label", "adjudication_label", "critical", "synthetic", "contains_business_payload", "input_fixture", "expected_fixture", "immutable_input_digest", "expected_output_digest"],
      "properties": {
        "case_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,100}$"},
        "split": {"enum": ["development", "tuning", "held_out", "temporal_holdout", "prospective_non_derivation"]},
        "suite_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["held_out_real", "temporal", "adversarial", "accumulation", "outage", "public_directional", "exact_vs_ann", "lexical_degraded"]}},
        "label": {"type": "string", "minLength": 3, "maxLength": 120},
        "adjudication_label": {"enum": ["supported", "unsupported", "contradictory", "scope_violation", "unresolved"]},
        "critical": {"type": "boolean"},
        "synthetic": {"const": true},
        "contains_business_payload": {"const": false},
        "input_fixture": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_-]+:[a-z0-9_-]+$"}},
        "expected_fixture": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_-]+:[a-z0-9_-]+$"}},
        "immutable_input_digest": {"$ref": "#/$defs/digest"},
        "expected_output_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "scope_fixtures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenants", "sponsors", "agents", "projects", "sessions", "cases"],
      "properties": {
        "tenants": {"$ref": "#/$defs/two_synthetic_ids"},
        "sponsors": {"$ref": "#/$defs/two_synthetic_ids"},
        "agents": {"$ref": "#/$defs/two_synthetic_ids"},
        "projects": {"$ref": "#/$defs/two_synthetic_ids"},
        "sessions": {"type": "array", "minItems": 2, "maxItems": 2, "x-carr-unique-by": "id", "items": {"$ref": "#/$defs/synthetic_session"}},
        "cases": {"type": "array", "minItems": 2, "maxItems": 12, "x-carr-unique-by": "case_id", "items": {"$ref": "#/$defs/scope_case"}}
      }
    },
    "two_synthetic_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "x-carr-unique-by": "id",
      "items": {"$ref": "#/$defs/synthetic_id"}
    },
    "synthetic_id": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "synthetic"],
      "properties": {"id": {"type": "string", "minLength": 3, "maxLength": 100}, "synthetic": {"const": true}}
    },
    "synthetic_session": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "tenant_id", "synthetic"],
      "properties": {"id": {"type": "string", "minLength": 3, "maxLength": 100}, "tenant_id": {"type": "string", "minLength": 3, "maxLength": 100}, "synthetic": {"const": true}}
    },
    "scope_case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "tenant_id", "sponsor_id", "agent_id", "project_id", "session_id", "synthetic", "contains_business_payload", "expected_assertions", "immutable_input_digest", "expected_output_digest"],
      "properties": {
        "case_id": {"type": "string", "minLength": 3, "maxLength": 100},
        "tenant_id": {"type": "string", "minLength": 3, "maxLength": 100},
        "sponsor_id": {"type": "string", "minLength": 3, "maxLength": 100},
        "agent_id": {"type": "string", "minLength": 3, "maxLength": 100},
        "project_id": {"type": "string", "minLength": 3, "maxLength": 100},
        "session_id": {"type": "string", "minLength": 3, "maxLength": 100},
        "synthetic": {"const": true},
        "contains_business_payload": {"const": false},
        "expected_assertions": {"type": "array", "minItems": 2, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_-]+:[a-z0-9_-]+$"}},
        "immutable_input_digest": {"$ref": "#/$defs/digest"},
        "expected_output_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "threat_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "human_acceptance", "threats"],
      "properties": {
        "authority": {"$ref": "#/$defs/authority"},
        "human_acceptance": {"$ref": "#/$defs/human_acceptance"},
        "threats": {"type": "array", "minItems": 10, "maxItems": 30, "x-carr-unique-by": "threat_id", "items": {"$ref": "#/$defs/threat"}}
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memory_is_authority", "model_can_activate", "neon_is_sole_canonical_store"],
      "properties": {
        "memory_is_authority": {"const": false},
        "model_can_activate": {"const": false},
        "neon_is_sole_canonical_store": {"const": true}
      }
    },
