      "properties": {
        "work_request_ref": {"const": "WR-000013"},
        "work_request_version": {"const": 3},
        "accepted_plan_ref": {"const": "PLAN-d85ba97ccd46-v1"},
        "accepted_plan_digest": {"const": "sha256:d85ba97ccd4686b619fe72eaab80732057327ecbdb9b436fd1af2083960bad2e"},
        "registered_slice_plan_id": {"const": "cfc1d210-1069-4994-8145-8ef9b1299e9c"},
        "registered_slice_plan_digest": {"const": "sha256:5bb7039f727da6c99d2b7b36a563b12234360bdb23219ab7800e42dbc7ce2149"},
        "runbook_section_id": {"const": "0d3a6481-583f-4b3a-893f-505fd98ddcb4"},
        "runbook_revision_id": {"const": "0c3ecb3e-ff2f-49ac-8466-60f5f698726a"},
