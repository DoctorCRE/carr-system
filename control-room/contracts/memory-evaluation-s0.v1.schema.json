    "forbidden_changes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"enum": [
        "forbid:parallel-context-authority",
        "forbid:raw-transcript-mirror",
        "forbid:model-self-approval",
        "forbid:simultaneous-hermes-neon-authority",
        "forbid:shared-postfilter-ann",
        "forbid:implicit-policy-override",
        "forbid:mutable-history"
      ]}
    },
    "artifact_digest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nonempty": {"type": "string", "minLength": 1, "maxLength": 2000},
    "reference": {"type": "string", "pattern": "^(repo:|test:|gate:|check:|resource:|owner:|https://|doctrine:)[^\\s]+$"},
