      "type": "object",
      "additionalProperties": false,
      "required": ["status", "approver_role", "executor_role", "distinct_actor_required", "acceptance_requires", "binding_fields", "evidence_fields", "failure_action"],
      "properties": {
        "status": {"const": "contract_only_no_acceptance_recorded"},
        "approver_role": {"const": "verified_human"},
        "executor_role": {"const": "agent_executor"},
        "distinct_actor_required": {"const": true},
        "acceptance_requires": {"const": "fresh_execution_envelope_and_typed_receipt"},
        "binding_fields": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"enum": ["work_request_ref", "work_request_version", "accepted_plan_ref", "accepted_plan_digest", "slice_ref", "envelope_id", "source_commit", "artifact_digest"]}
        },
        "evidence_fields": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": {"enum": ["human_approver_ref", "executor_ref", "accepted_at", "receipt_ref", "acceptance_digest", "independent_session_ref"]}
        },
        "failure_action": {"const": "block_release"}
      }
    },
    "threat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["threat_id", "asset_ref", "boundary_ref", "abuse_case", "severity", "likelihood", "owner_ref", "controls", "mitigation_refs", "evidence_refs", "test_refs", "release_action"],
      "properties": {
        "threat_id": {"enum": ["cross_scope_leak", "memory_poisoning", "secret_capture", "stale_publish_race", "model_self_approval", "dual_memory_authority", "shared_postfilter_ann", "deletion_restore_revival", "opaque_ranking", "cost_runaway"]},
        "asset_ref": {"type": "string", "pattern": "^asset:[a-z0-9-]+$"},
        "boundary_ref": {"type": "string", "pattern": "^boundary:[a-z0-9-]+$"},
        "abuse_case": {"type": "string", "minLength": 20, "maxLength": 1000},
        "severity": {"enum": ["critical", "high", "medium", "low"]},
        "likelihood": {"enum": ["high", "medium", "low"]},
        "owner_ref": {"type": "string", "pattern": "^owner:[a-z0-9-]+$"},
        "controls": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 500}},
        "mitigation_refs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^control:[a-z0-9-]+$"}},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
        "test_refs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^(test:|check:|gate:).+"}},
        "release_action": {"enum": ["block_release", "require_review", "pause_canary", "degrade_lexical"]}
      }
    },
    "cost_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelopes", "ceilings", "measurements", "storage_model"],
      "properties": {
        "envelopes": {"type": "array", "minItems": 2, "maxItems": 2, "x-carr-unique-by": "envelope_id", "items": {"$ref": "#/$defs/cost_envelope"}},
        "ceilings": {"type": "array", "minItems": 14, "maxItems": 14, "x-carr-unique-by": "ceiling_id", "items": {"$ref": "#/$defs/ceiling"}},
        "measurements": {"type": "array", "minItems": 3, "maxItems": 3, "x-carr-unique-by": "measurement_id", "items": {"$ref": "#/$defs/measurement"}},
        "storage_model": {"$ref": "#/$defs/storage_model"}
      }
    },
    "cost_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_id", "horizon_months", "scope", "window", "measurement_ref"],
      "properties": {
        "envelope_id": {"enum": ["carr_operating_12_month", "fleet_stress_12_month"]},
        "horizon_months": {"const": 12},
        "scope": {"type": "string", "minLength": 8, "maxLength": 200},
        "window": {"const": "12_months"},
        "measurement_ref": {"type": "string", "pattern": "^measurement:(latency|cost|storage)$"}
      }
    },
    "ceiling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ceiling_id", "limit", "unit", "scope", "window", "measurement_ref", "formula", "bound_action"],
      "properties": {
        "ceiling_id": {"enum": ["event_bytes", "events_session", "routine_model_jobs", "proposed_memories", "neighbors", "score_rows", "queue_p95", "canary_spend", "live_spend", "ann_payload", "latency_prefetch", "latency_deep", "tokens_prefetch", "tokens_deep"]},
        "limit": {"type": "number", "minimum": 0.000001},
        "unit": {"enum": ["bytes", "events", "model_jobs", "memories", "neighbors", "score_rows", "minutes", "usd_per_day", "payload_ratio", "milliseconds", "model_tokens"]},
        "scope": {"type": "string", "minLength": 3, "maxLength": 200},
        "window": {"type": "string", "minLength": 2, "maxLength": 100},
        "measurement_ref": {"type": "string", "pattern": "^measurement:(latency|cost|storage)$"},
        "formula": {"type": "string", "minLength": 8, "maxLength": 500},
        "bound_action": {"type": "string", "minLength": 8, "maxLength": 500}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_id", "measurement_status", "value", "unit", "sample_count", "window", "measured_at", "estimate_basis", "evidence_refs"],
      "properties": {
        "measurement_id": {"enum": ["latency", "cost", "storage"]},
        "measurement_status": {"enum": ["estimated", "measured"]},
        "value": {"type": "number", "minimum": 0},
        "unit": {"enum": ["milliseconds", "usd", "bytes"]},
        "sample_count": {"type": "integer", "minimum": 1},
        "window": {"type": "string", "minLength": 2, "maxLength": 100},
        "measured_at": {"type": "string", "format": "date-time"},
        "estimate_basis": {"type": "string", "minLength": 12, "maxLength": 500},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}
      }
    },
    "storage_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "starting_envelopes"],
      "properties": {
        "components": {"type": "array", "minItems": 3, "maxItems": 3, "x-carr-unique-by": "component_id", "items": {"$ref": "#/$defs/storage_component"}},
        "starting_envelopes": {"type": "array", "minItems": 2, "maxItems": 2, "x-carr-unique-by": "envelope_id", "items": {"$ref": "#/$defs/storage_envelope"}}
      }
    },
    "storage_component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "baseline_bytes", "growth_bytes_per_window", "window", "retention_days", "formula", "bound_action"],
      "properties": {
        "component_id": {"enum": ["memory_rows", "evidence_rows", "indexes"]},
        "baseline_bytes": {"type": "integer", "minimum": 0},
        "growth_bytes_per_window": {"type": "integer", "minimum": 0},
        "window": {"const": "30_days"},
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 3650},
        "formula": {"type": "string", "minLength": 8, "maxLength": 500},
        "bound_action": {"type": "string", "minLength": 8, "maxLength": 500}
      }
    },
    "storage_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["envelope_id", "window", "scale_multiplier", "sponsor_count", "agent_count", "session_count", "event_count", "retrieval_count", "baseline_bytes", "growth_bytes", "retention_days", "measurement_ref"],
      "properties": {
        "envelope_id": {"enum": ["carr_operating_12_month", "fleet_stress_12_month"]},
        "window": {"const": "12_months"},
        "scale_multiplier": {"type": "integer", "minimum": 1},
        "sponsor_count": {"type": "integer", "minimum": 0},
        "agent_count": {"type": "integer", "minimum": 0},
        "session_count": {"type": "integer", "minimum": 0},
        "event_count": {"type": "integer", "minimum": 0},
        "retrieval_count": {"type": "integer", "minimum": 0},
        "baseline_bytes": {"type": "integer", "minimum": 0},
        "growth_bytes": {"type": "integer", "minimum": 0},
        "retention_days": {"type": "integer", "minimum": 1, "maximum": 3650},
        "measurement_ref": {"const": "measurement:storage"}
      }
    },
    "gap_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inventory_id", "status", "truthful_current_behavior", "evidence_refs", "gap", "owning_slice_ref", "executable_gate_ref", "baseline_gate_ref", "authority_class"],
      "properties": {
        "inventory_id": {"enum": ["migration-0299", "human-acceptance-runtime", "context-bundle-v1", "security-redaction-v1", "policy-learning-v1", "memory-evaluation", "hermes-native-memory", "standing-context", "situation-retrieval"]},
        "status": {"enum": ["current", "legacy", "partial", "missing"]},
        "truthful_current_behavior": {"type": "string", "minLength": 20, "maxLength": 1500},
        "evidence_refs": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
        "gap": {"type": "string", "minLength": 10, "maxLength": 1000},
        "owning_slice_ref": {"type": "string", "pattern": "^slice:learning-[a-z0-9-]+-v2$"},
        "executable_gate_ref": {"type": "string", "pattern": "^(check:|test:|gate:).+"},
        "baseline_gate_ref": {"const": "gate:S0-3-evidence-ownership"},
        "authority_class": {"enum": ["canonical", "derived", "advisory", "legacy_non_authoritative", "not_implemented"]}
      }
    },
    "acceptance_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "producing_slice_refs", "check_refs", "evidence_owner_refs", "executable_gate_refs", "baseline_gate_ref", "evidence_refs"],
      "properties": {
        "criterion_id": {"enum": ["RESEARCH-SOURCE-LOCK", "SINGLE-NEON-AUTHORITY", "IMMUTABLE-BITEMPORAL-LINEAGE", "ATTESTED-CONCURRENT-CAPTURE", "SCOPE-DATABASE-ISOLATION", "NONFORGEABLE-HUMAN-ACCEPTANCE", "SAFE-HERMES-CONTEXT", "HYBRID-PROGRESSIVE-RECALL", "POISONING-PRIVACY-DELETION", "EXECUTABLE-EVALUATION", "DEMONSTRATED-PROCEDURAL-LEARNING", "OPERATED-RECOVERED-FIRST-USE"]},
        "producing_slice_refs": {"type": "array", "minItems": 1, "maxItems": 14, "uniqueItems": true, "items": {"type": "string", "pattern": "^slice:learning-[a-z0-9-]+-v2$"}},
        "check_refs": {"type": "array", "minItems": 1, "maxItems": 42, "uniqueItems": true, "items": {"type": "string", "pattern": "^check:S([0-9]|1[0-3])-[1-3]$"}},
        "evidence_owner_refs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^owner:[a-z0-9-]+$"}},
        "executable_gate_refs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^(test:|gate:|check:).+"}},
        "baseline_gate_ref": {"const": "gate:S0-3-evidence-ownership"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}}
      }
    }
  }
}
