        "revision_ref": {"const": "revision:3"},
        "content_digest": {"enum": [
          "sha256:a4bd7234feadf4556abc10091a6e7464b96fcb8a293fc0dbfce3ad6171a6996d",
          "sha256:9deb92a11ce6e86c96427b26d53d1600163888d69a6ddc8e4950327e11cf471c",
          "sha256:f802c5ef05ebb49c64adc28725f544fb2d34c60b4ee63b9cce6ba7c11aefc0ff",
          "sha256:39c51c478ceff930a43bdb6846c17515c2a6c236603472866c8ad018c4c7604c",
          "sha256:78d122e08129a489f3f14ef850f890c5a7ba276096924f448eb48f7d8103914a"
        ]}
      },
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_ref", "revision_ref", "content_digest"],
          "properties": {
            "resource_ref": {"const": "resource:source-lock"},
            "revision_ref": {"const": "revision:3"},
            "content_digest": {"const": "sha256:a4bd7234feadf4556abc10091a6e7464b96fcb8a293fc0dbfce3ad6171a6996d"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_ref", "revision_ref", "content_digest"],
          "properties": {
            "resource_ref": {"const": "resource:evaluation-contract"},
            "revision_ref": {"const": "revision:3"},
            "content_digest": {"const": "sha256:9deb92a11ce6e86c96427b26d53d1600163888d69a6ddc8e4950327e11cf471c"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_ref", "revision_ref", "content_digest"],
          "properties": {
            "resource_ref": {"const": "resource:threat-model"},
            "revision_ref": {"const": "revision:3"},
            "content_digest": {"const": "sha256:f802c5ef05ebb49c64adc28725f544fb2d34c60b4ee63b9cce6ba7c11aefc0ff"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_ref", "revision_ref", "content_digest"],
          "properties": {
            "resource_ref": {"const": "resource:cost-model"},
            "revision_ref": {"const": "revision:3"},
            "content_digest": {"const": "sha256:39c51c478ceff930a43bdb6846c17515c2a6c236603472866c8ad018c4c7604c"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["resource_ref", "revision_ref", "content_digest"],
          "properties": {
            "resource_ref": {"const": "resource:legacy-inventory"},
            "revision_ref": {"const": "revision:3"},
            "content_digest": {"const": "sha256:78d122e08129a489f3f14ef850f890c5a7ba276096924f448eb48f7d8103914a"}
          }
        }
      ]
    },
    "resource_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_ref", "revision_ref", "content_digest"],
      "properties": {
        "resource_ref": {"enum": ["resource:source-lock", "resource:evaluation-contract", "resource:threat-model", "resource:cost-model", "resource:legacy-inventory"]},
        "revision_ref": {"const": "revision:3"},
        "content_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_ref", "check_ref", "owner_ref", "command", "evidence_requirement"],
      "properties": {
        "gate_ref": {"enum": ["gate:S0-1-source-lock", "gate:S0-2-evaluation-contract", "gate:S0-3-evidence-ownership"]},
        "check_ref": {"enum": ["check:S0-1", "check:S0-2", "check:S0-3"]},
        "owner_ref": {"type": "string", "pattern": "^owner:[a-z0-9-]+$"},
        "command": {"type": "string", "pattern": "^node --test --test-name-pattern='check:S0-[1-3]' control-room/test/contracts\\.test\\.mjs$"},
        "evidence_requirement": {"const": "redacted_evidence_required"}
      }
    },
    "source_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "gate_ref", "sources"],
      "properties": {
        "policy": {"type": "string", "minLength": 20, "maxLength": 1000},
        "gate_ref": {"const": "gate:S0-1-source-lock"},
        "sources": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "x-carr-unique-by": "source_id",
          "items": {"$ref": "#/$defs/source"}
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "family", "exact_ref", "pin", "behavior_epoch", "claim_class", "claims", "verification"],
      "properties": {
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$"},
        "family": {"enum": ["mem0", "openviking", "hermes", "neon", "postgresql", "carr", "practitioner"]},
        "exact_ref": {"type": "string", "pattern": "^(https://|repo:|doctrine:).+"},
        "pin": {"$ref": "#/$defs/pin"},
        "behavior_epoch": {"enum": ["current", "legacy", "mixed"]},
        "claim_class": {"enum": ["vendor_claim", "packet_bound_claim", "source_inspected", "locally_reproduced"]},
        "claims": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 10, "maxLength": 1000}},
        "verification": {"$ref": "#/$defs/verification"}
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "kind"],
      "properties": {
        "value": {"type": "string", "pattern": "^(git:[a-f0-9]{7,40}|sha256:[a-f0-9]{64}|revision:[a-z0-9][a-z0-9._:-]+)$"},
        "kind": {"type": "string", "minLength": 3, "maxLength": 100}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "observed_at", "max_age_days", "status", "verification_ref"],
      "properties": {
        "method": {"type": "string", "minLength": 8, "maxLength": 500},
        "observed_at": {"type": "string", "format": "date-time"},
        "max_age_days": {"type": "integer", "minimum": 1, "maximum": 90},
        "status": {"const": "fresh"},
        "verification_ref": {"$ref": "#/$defs/reference"}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_ref", "corpus_digest", "splits", "suites", "labels", "metrics", "confidence", "model_versions", "index_generation", "outcome_horizons", "measurement_units", "cases"],
      "properties": {
        "gate_ref": {"const": "gate:S0-2-evaluation-contract"},
        "corpus_digest": {"$ref": "#/$defs/digest"},
        "splits": {"type": "array", "minItems": 5, "maxItems": 5, "x-carr-unique-by": "name", "items": {"$ref": "#/$defs/split"}},
        "suites": {"type": "array", "minItems": 8, "maxItems": 8, "x-carr-unique-by": "suite_id", "items": {"$ref": "#/$defs/suite"}},
        "labels": {"$ref": "#/$defs/labels"},
        "metrics": {"type": "array", "minItems": 6, "maxItems": 30, "x-carr-unique-by": "metric_id", "items": {"$ref": "#/$defs/metric"}},
        "confidence": {"$ref": "#/$defs/confidence"},
        "model_versions": {"$ref": "#/$defs/model_versions"},
        "index_generation": {"type": "string", "minLength": 8, "maxLength": 200},
