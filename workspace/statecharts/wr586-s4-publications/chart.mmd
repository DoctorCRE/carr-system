stateDiagram-v2
 state ClientView {
  state Publication {
   [*] --> Unpublished
   Unpublished --> Published: Partner publishes
   Published --> Published: Partner publishes
   Published --> Unpublished: Partner unpublishes
   Published --> Published: Partner makes file private
   Published --> Published: Partner replaces content
   Unpublished --> Unpublished: Partner edits draft
  }
  --
  state Client {
   [*] --> Hidden
   Hidden --> Visible: Partner publishes
   Visible --> Visible: Partner publishes
   Visible --> Hidden: Partner unpublishes
   Hidden --> Hidden: Partner unpublishes
   Visible --> Hidden: Partner makes file private
   Hidden --> Hidden: Partner makes file private
   Visible --> Visible: Partner replaces content
   Hidden --> Hidden: Partner edits draft
   Hidden --> Hidden: Client reads
   Visible --> Visible: Client reads
  }
  --
  state Version {
   [*] --> Empty
   Empty --> Saved: Partner saves draft
   Empty --> Saved: Partner edits draft
   Empty --> Saved: Partner publishes
   Saved --> Saved: Partner publishes
   Saved --> Saved: Partner unpublishes
   Saved --> Saved: Partner replaces content
   Saved --> Saved: Partner edits draft
   Saved --> Saved: Partner saves matching version
   Saved --> Saved: Partner retries same action
   Saved --> Conflict: Partner saves stale version
   Conflict --> Saved: Partner reads current version
  }
 }
 %% never OnlyPublished: Unpublished & Visible -- Unpublished items never appear to the client
 %% never RecordRequired: Published & Empty -- A published item always has a saved version
