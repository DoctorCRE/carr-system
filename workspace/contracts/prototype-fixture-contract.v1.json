  "state_invariants": [
    {
      "state": "normal",
      "required": [
        "freshness",
        "surface-specific canonical payload"
      ]
    },
    {
      "state": "loading",
      "required": [
        "named loading purpose",
        "no false empty state"
      ]
    },
    {
      "state": "empty",
      "required": [
        "what is empty",
        "safe next action when applicable"
      ]
    },
    {
      "state": "partial",
      "required": [
        "loaded and unavailable scope",
        "no aggregate over missing source"
      ]
    },
    {
      "state": "stale",
      "required": [
        "observed time",
        "stale label",
        "edits disabled"
      ]
    },
    {
      "state": "offline",
      "required": [
        "last safe snapshot time",
        "read/local truth",
        "no fabricated answer"
      ]
    },
    {
      "state": "unauthorized",
      "required": [
        "no private metadata",
        "safe return or sign-in action"
      ]
    },
    {
      "state": "conflict",
      "required": [
        "review path",
        "no silent overwrite"
      ]
    },
    {
      "state": "refusal",
      "required": [
        "safe reason",
        "allowed alternative"
      ]
    },
    {
      "state": "retry",
      "required": [
        "typed retry-safe failure",
        "no duplicate effect"
      ]
    }
  ]
}