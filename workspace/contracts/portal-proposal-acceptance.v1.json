{
  "schema_version": "portal-proposal-acceptance.v1",
  "version": "1.0.0",
  "owner": "DoctorCRE/carr-system",
  "read_verb": "read-portal-proposal-review-v1",
  "accept_verb": "accept-portal-proposal-v1",
  "read_request": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "deal_id": {
        "type": "string",
        "format": "uuid"
      },
      "publication_id": {
        "type": "string",
        "format": "uuid"
      },
      "tour_id": {
        "type": "string",
        "format": "uuid"
      }
    },
    "required": [
      "deal_id",
      "publication_id",
      "tour_id"
    ]
  },
  "accept_request": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "deal_id": {
        "type": "string",
        "format": "uuid"
      },
      "publication_id": {
        "type": "string",
        "format": "uuid"
      },
      "tour_id": {
        "type": "string",
        "format": "uuid"
      },
      "idempotency_key": {
        "type": "string",
        "format": "uuid"
      },
      "publication_version": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483646
      },
      "source_version": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483646
      },
      "cart_version": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483646
      },
      "cart_version_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "decision": {
        "enum": [
          "accept",
          "keep"
        ]
      },
      "property_ids": {
        "type": "array",
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "required": [
      "deal_id",
      "publication_id",
      "tour_id",
      "idempotency_key",
      "publication_version",
      "source_version",
      "cart_version",
      "cart_version_id",
      "decision",
      "property_ids"
    ]
  },
  "review": {
    "type": "object",
    "required": [
      "schema_version",
      "state",
      "deal_id",
      "publication_id",
      "tour_id",
      "publication_version",
      "source_version",
      "cart_version",
      "cart_version_id",
      "selected",
      "mine",
      "notes",
      "added",
      "removed",
      "retained",
      "retired"
    ],
    "properties": {
      "deal_id": {
        "type": "string",
        "format": "uuid"
      },
      "publication_id": {
        "type": "string",
        "format": "uuid"
      },
      "tour_id": {
        "type": "string",
        "format": "uuid"
      },
      "schema_version": {
        "const": "portal-proposal-acceptance.v1"
      },
      "state": {
        "enum": [
          "reviewed",
          "accepted",
          "kept"
        ]
      },
      "publication_version": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483646
      },
      "source_version": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483646
      },
      "cart_version": {
        "type": "integer",
        "minimum": 0,
        "maximum": 2147483646
      },
      "cart_version_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      },
      "selected": {
        "type": "array",
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "mine": {
        "type": "array",
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "added": {
        "type": "array",
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "removed": {
        "type": "array",
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "retained": {
        "type": "array",
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "retired": {
        "type": "array",
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "property_ids": {
        "type": "array",
        "maxItems": 100,
        "uniqueItems": true,
        "items": {
          "type": "string",
          "format": "uuid"
        }
      },
      "notes": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "maxLength": 2000
        }
      },
      "selection_version_id": {
        "anyOf": [
          {
            "type": "string",
            "format": "uuid"
          },
          {
            "type": "null"
          }
        ]
      }
    }
  },
  "read_response": {
    "ok": true,
    "review": "review schema",
    "pending": "null if existing event settles this publication/source version; otherwise action_confirmation",
    "decision": "null or original source-bound audit receipt, including accepted/kept state and resulting selection_version_id"
  },
  "signal": {
    "class": "review_needed",
    "topic": "action_confirmation",
    "dedupe_key": [
      "principal_id",
      "publication_id",
      "source_version"
    ],
    "line": "Client Tour List choices await your review.",
    "bounded": "One signal per exact review; rank 7 lists authorized tour publications through the existing bounded publication read. No push service or new notification kind."
  },
  "semantics": {
    "theirs": "Accept the selected array, explicitly exclude retired IDs.",
    "mine": "decision=keep with the exact mine array; writes audit and receipt, appends no cart.",
    "choices": "decision=accept with an exact subset of selected union mine, excluding retired IDs.",
    "stale": "proposal_source_changed requires another review of both versions.",
    "unknown": "Retry the same frozen idempotency key and exact request. Original receipt replays for the existing 30-day tool_call window.",
    "retired": "Authorization and publication retirement are checked before replay.",
    "notes": "Exact private client source text; never copied into canonical property facts.",
    "production_proof": "On a containing release compare an existing proposal/current cart difference and an existing authorized acceptance receipt against the immutable resulting cart. No qualifying receipt means exit 78."
  }
}
