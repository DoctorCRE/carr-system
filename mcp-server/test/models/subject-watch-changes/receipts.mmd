---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef works fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef wrong fill:#fdedec,stroke:#c0392b,color:#7b241c
  classDef fixed fill:#e9f7ef,stroke:#1e8449,color:#145a32
  classDef worksPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef wrongPath fill:#fdedec,stroke:#1f3a93,stroke-width:4px,color:#7b241c
  classDef fixedPath fill:#e9f7ef,stroke:#1f3a93,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Works" as legendWorks
  }
  class legendWorks works
  state "Change committed, receipt<br/>pending" as s0
  state "Change uncommitted, no<br/>receipt visible" as s1
  state "No new change or receipt" as s2
  [*] --> s2
  s2 --> s1 : Registered write or Keyed raw<br/>ingress or Unkeyed raw ingress
  s1 --> s2 : Rollback
  s1 --> s0 : Commit
  class s0 works
  class s1 works
  class s2 works

  %% never AtomicCapture: Pending & Quiet -- Never publish a receipt for a rolled back change.
  %% never NoLostCapture: Hidden & Committed -- Never lose a committed material change, including raw keyed ingress.
  %% never NoIntermediateReceipt: Pending & Open -- Never expose intermediate writes as committed receipts.
