---- MODULE Receipts ----
\* Generated by chart-to-tla.mjs from receipts.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart receipts.mmd keeps it, checks it, and compares it with the chart.

VARIABLES source, receipt
vars == <<source, receipt>>

\* Region Source
sourceStates == {"Unchanged", "Written"}
\* Region Receipt
receiptStates == {"Pending", "Quiet"}

TypeOK ==
    /\ source \in sourceStates
    /\ receipt \in receiptStates

Init ==
    /\ source = "Unchanged"
    /\ receipt = "Quiet"

\* Equivalent commit
EquivalentCommit ==
    /\ (source \in {"Unchanged"} \/ receipt \in {"Quiet"})
    /\ \/ (source = "Unchanged" /\ source' = "Unchanged")
       \/ (source \notin {"Unchanged"} /\ UNCHANGED source)
    /\ \/ (receipt = "Quiet" /\ receipt' = "Quiet")
       \/ (receipt \notin {"Quiet"} /\ UNCHANGED receipt)

\* Rollback
Rollback ==
    /\ (source \in {"Unchanged", "Written"} \/ receipt \in {"Quiet", "Pending"})
    /\ \/ (source = "Unchanged" /\ source' = "Unchanged")
       \/ (source = "Written" /\ source' = "Written")
       \/ (source \notin {"Unchanged", "Written"} /\ UNCHANGED source)
    /\ \/ (receipt = "Quiet" /\ receipt' = "Quiet")
       \/ (receipt = "Pending" /\ receipt' = "Pending")
       \/ (receipt \notin {"Quiet", "Pending"} /\ UNCHANGED receipt)

\* Meaningful commit
MeaningfulCommit ==
    /\ (source \in {"Unchanged"} \/ receipt \in {"Quiet"})
    /\ \/ (source = "Unchanged" /\ source' = "Written")
       \/ (source \notin {"Unchanged"} /\ UNCHANGED source)
    /\ \/ (receipt = "Quiet" /\ receipt' = "Pending")
       \/ (receipt \notin {"Quiet"} /\ UNCHANGED receipt)

\* Replay
Replay ==
    /\ (source \in {"Written"} \/ receipt \in {"Pending"})
    /\ \/ (source = "Written" /\ source' = "Written")
       \/ (source \notin {"Written"} /\ UNCHANGED source)
    /\ \/ (receipt = "Pending" /\ receipt' = "Pending")
       \/ (receipt \notin {"Pending"} /\ UNCHANGED receipt)

Next == EquivalentCommit \/ Rollback \/ MeaningfulCommit \/ Replay

Spec == Init /\ [][Next]_vars

\* No receipt without a committed material change.
AtomicCapture == ~(receipt = "Pending" /\ source = "Unchanged")

\* A committed meaningful change has a pending receipt.
NoLostCapture == ~(receipt = "Quiet" /\ source = "Written")

====
