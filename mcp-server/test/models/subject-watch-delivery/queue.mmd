---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef works fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef wrong fill:#fdedec,stroke:#c0392b,color:#7b241c
  classDef fixed fill:#e9f7ef,stroke:#1e8449,color:#145a32
  classDef worksPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef wrongPath fill:#fdedec,stroke:#1f3a93,stroke-width:4px,color:#7b241c
  classDef fixedPath fill:#e9f7ef,stroke:#1f3a93,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Works" as legendWorks
  }
  class legendWorks works
  state "Queue advancing, alerts 1,<br/>2, head unlocked" as s0
  state "Queue advancing, alerts 1,<br/>head unlocked" as s1
  state "Queue advancing, alerts 2,<br/>head locked" as s2
  state "Queue advancing, alerts 2,<br/>head unlocked" as s3
  state "Queue advancing, alerts<br/>none, head locked" as s4
  state "Queue advancing, alerts<br/>none, head unlocked" as s5
  state "Queue at end, alerts 1, 2,<br/>head unlocked" as s6
  state "Queue at end, alerts 2,<br/>head locked" as s7
  state "Queue at end, alerts 2,<br/>head unlocked" as s8
  [*] --> s4
  s4 --> s5 : The held transaction finishes
  s4 --> s7 : Try the next waiting watch
  s5 --> s1 : Try the next waiting watch
  s7 --> s2 : Start the next queue pass
  s7 --> s8 : The held transaction finishes
  s5 --> s8 : Try the next waiting watch
  s1 --> s6 : Try the next waiting watch
  s2 --> s3 : The held transaction finishes
  s8 --> s3 : Start the next queue pass
  s6 --> s0 : Start the next queue pass
  s2 --> s7 : Try the next waiting watch
  s3 --> s0 : Try the next waiting watch
  s3 --> s8 : Try the next waiting watch
  s0 --> s6 : Try the next waiting watch
  class s0 works
  class s1 works
  class s2 works
  class s3 works
  class s4 works
  class s5 works
  class s6 works
  class s7 works
  class s8 works
