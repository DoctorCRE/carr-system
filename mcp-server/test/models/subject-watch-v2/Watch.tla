---- MODULE Watch ----
\* Generated by chart-to-tla.mjs from watch.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart watch.mmd keeps it, checks it, and compares it with the chart.

VARIABLES lifecycle, subscription
vars == <<lifecycle, subscription>>

\* Region Lifecycle
lifecycleStates == {"Absent", "Paused", "Removed", "Replaced", "Rewatched", "Watching"}
\* Region Subscription
subscriptionStates == {"Missing", "Present"}

TypeOK ==
    /\ lifecycle \in lifecycleStates
    /\ subscription \in subscriptionStates

Init ==
    /\ lifecycle = "Absent"
    /\ subscription = "Missing"

\* Watch
Watch ==
    /\ (lifecycle \in {"Absent", "Removed"} \/ subscription \in {"Missing"})
    /\ \/ (lifecycle = "Absent" /\ lifecycle' = "Watching")
       \/ (lifecycle = "Removed" /\ lifecycle' = "Rewatched")
       \/ (lifecycle \notin {"Absent", "Removed"} /\ UNCHANGED lifecycle)
    /\ \/ (subscription = "Missing" /\ subscription' = "Present")
       \/ (subscription \notin {"Missing"} /\ UNCHANGED subscription)

\* Repeat watch
RepeatWatch ==
    /\ \/ (lifecycle = "Watching" /\ lifecycle' = "Watching")
    /\ UNCHANGED <<subscription>>

\* Pause
Pause ==
    /\ \/ (lifecycle = "Watching" /\ lifecycle' = "Paused")
       \/ (lifecycle = "Replaced" /\ lifecycle' = "Paused")
       \/ (lifecycle = "Rewatched" /\ lifecycle' = "Paused")
    /\ UNCHANGED <<subscription>>

\* Resume
Resume ==
    /\ \/ (lifecycle = "Paused" /\ lifecycle' = "Watching")
    /\ UNCHANGED <<subscription>>

\* Replace policy
ReplacePolicy ==
    /\ \/ (lifecycle = "Watching" /\ lifecycle' = "Replaced")
       \/ (lifecycle = "Rewatched" /\ lifecycle' = "Replaced")
    /\ UNCHANGED <<subscription>>

\* Replace paused policy
ReplacePausedPolicy ==
    /\ \/ (lifecycle = "Paused" /\ lifecycle' = "Paused")
    /\ UNCHANGED <<subscription>>

\* Remove
Remove ==
    /\ (lifecycle \in {"Replaced", "Watching", "Paused", "Rewatched"} \/ subscription \in {"Present"})
    /\ \/ (lifecycle = "Replaced" /\ lifecycle' = "Removed")
       \/ (lifecycle = "Watching" /\ lifecycle' = "Removed")
       \/ (lifecycle = "Paused" /\ lifecycle' = "Removed")
       \/ (lifecycle = "Rewatched" /\ lifecycle' = "Removed")
       \/ (lifecycle \notin {"Replaced", "Watching", "Paused", "Rewatched"} /\ UNCHANGED lifecycle)
    /\ \/ (subscription = "Present" /\ subscription' = "Missing")
       \/ (subscription \notin {"Present"} /\ UNCHANGED subscription)

Next == Watch \/ RepeatWatch \/ Pause \/ Resume \/ ReplacePolicy \/ ReplacePausedPolicy \/ Remove

Spec == Init /\ [][Next]_vars

\* Removed subscriptions cannot remain present.
RemovalIsExact == ~(lifecycle = "Removed" /\ subscription = "Present")

\* Watching requires a subscription generation.
WatchExists == ~(lifecycle = "Watching" /\ subscription = "Missing")

====
