{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "client-needs.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "subject_id",
    "as_of",
    "state",
    "rows",
    "next_offset"
  ],
  "properties": {
    "schema_version": {
      "const": "client-needs.v1"
    },
    "subject": {
      "enum": [
        "deal",
        "vendor"
      ]
    },
    "subject_id": {
      "type": "string",
      "minLength": 1
    },
    "as_of": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "ready",
        "missing_approval",
        "empty"
      ]
    },
    "rows": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": [
          "id",
          "deal_id",
          "vendor_id",
          "client_id",
          "version",
          "source_ref",
          "source_revision",
          "applicability",
          "restriction",
          "observed_at",
          "fresh_until",
          "approved_revision",
          "approved_by",
          "approved_at",
          "state"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "deal_id": {
            "type": "string",
            "minLength": 1
          },
          "vendor_id": {
            "type": "string",
            "minLength": 1
          },
          "client_id": {
            "type": "string",
            "minLength": 1
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "source_revision": {
            "type": "string",
            "minLength": 1
          },
          "applicability": {
            "type": "string",
            "minLength": 1
          },
          "observed_at": {
            "type": "string",
            "minLength": 1
          },
          "fresh_until": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "restriction": {
            "enum": [
              "allowed",
              "restricted"
            ]
          },
          "state": {
            "enum": [
              "draft",
              "approved",
              "edited_lapsed",
              "withdrawn",
              "stale"
            ]
          },
          "approved_revision": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "approved_by": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "approved_at": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "next_offset": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        {
          "type": "null"
        }
      ]
    }
  }
}
