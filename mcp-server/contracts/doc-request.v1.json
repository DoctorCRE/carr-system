{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-request.v1",
  "title": "Queued partner ask",
  "description": "Accepted means one canonical human turn and immutable actor/key receipt committed atomically. Refused means verified pre-acceptance refusal. Transport errors and other results are unknown. A new key is a new request. Existing completion handles answers.",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "idempotency_key",
        "conversation_id",
        "body"
      ],
      "properties": {
        "idempotency_key": {
          "type": "string",
          "format": "uuid",
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
        },
        "conversation_id": {
          "type": "string",
          "format": "uuid"
        },
        "body": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20000,
          "pattern": "\\S"
        },
        "deal_id": {
          "type": "string",
          "format": "uuid"
        },
        "quote_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    },
    "response": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "contract",
            "conversation_id",
            "idempotency_key",
            "request_msg_id",
            "status"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "contract": {
              "const": "doc-request.v1"
            },
            "conversation_id": {
              "type": "string",
              "format": "uuid"
            },
            "idempotency_key": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "request_msg_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "status": {
              "const": "accepted"
            },
            "deal_id": {
              "type": "string",
              "format": "uuid"
            },
            "line_quotes": {
              "type": "array",
              "maxItems": 20,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "quote_id",
                  "quoted_text",
                  "comment"
                ],
                "properties": {
                  "quote_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "quoted_text": {
                    "type": "string",
                    "maxLength": 4000
                  },
                  "comment": {
                    "type": "string",
                    "maxLength": 4000
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ok",
            "contract",
            "conversation_id",
            "idempotency_key",
            "request_msg_id",
            "status",
            "reason"
          ],
          "properties": {
            "ok": {
              "const": true
            },
            "contract": {
              "const": "doc-request.v1"
            },
            "conversation_id": {
              "type": "string",
              "format": "uuid"
            },
            "idempotency_key": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "request_msg_id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
            },
            "status": {
              "const": "refused"
            },
            "reason": {
              "enum": [
                "doc_request_partner_required",
                "doc_request_key_invalid",
                "doc_conversation_id_invalid",
                "doc_conversation_body_invalid",
                "doc_conversation_not_found",
                "doc_request_key_reuse",
                "doc_request_deal_not_found",
                "doc_request_quotes_invalid"
              ]
            }
          }
        }
      ]
    }
  }
}
