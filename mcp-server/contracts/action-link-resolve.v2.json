{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "ref",
    "card"
  ],
  "properties": {
    "schema_version": {
      "const": "action-link-resolve.v2"
    },
    "ref": {
      "type": "string",
      "pattern": "^al1_[A-Za-z0-9_-]+$"
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "state",
        "source_version",
        "subject",
        "body",
        "to",
        "cc",
        "actions"
      ],
      "properties": {
        "kind": {
          "const": "reply_draft"
        },
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "state": {
          "const": "pending_approval"
        },
        "source_version": {
          "type": "integer",
          "minimum": 1
        },
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "to": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "cc": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "format": "email"
          }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "action",
              "verb",
              "args"
            ],
            "properties": {
              "action": {
                "const": "approve"
              },
              "verb": {
                "const": "submit-email-draft"
              },
              "args": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "proposal_id",
                  "base_version",
                  "subject",
                  "body",
                  "to",
                  "cc"
                ],
                "properties": {
                  "proposal_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "base_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "subject": {
                    "type": "string"
                  },
                  "body": {
                    "type": "string"
                  },
                  "to": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "format": "email"
                    }
                  },
                  "cc": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 1,
                    "items": {
                      "type": "string",
                      "format": "email"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reply draft action-link response"
}
