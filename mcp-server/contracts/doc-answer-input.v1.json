{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "doc-answer-input.v1",
  "title": "Authority-authored sourced answer selection",
  "$defs": {
    "request": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "idempotency_key": {
          "type": "string"
        },
        "conversation_id": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "msg_id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "human",
            "assistant",
            "system"
          ]
        },
        "comps_deals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "description": "Recorded proposed negotiation rents, not executed market history."
        },
        "market_terms": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "submarket": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "use_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "as_of": {
              "type": "string",
              "format": "date"
            }
          }
        },
        "chart_view": {
          "enum": [
            "none",
            "bar",
            "line"
          ],
          "default": "none"
        }
      },
      "required": [
        "idempotency_key",
        "conversation_id",
        "role",
        "body"
      ],
      "anyOf": [
        {
          "properties": {
            "market_terms": false
          }
        },
        {
          "properties": {
            "comps_deals": false
          }
        }
      ]
    }
  }
}
