{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "web-push-registry.v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ok": { "const": true },
    "schema_version": { "const": "web-push-registry.v1" },
    "replayed": { "type": "boolean" },
    "installation_id": { "type": "string", "format": "uuid" },
    "generation": { "type": "integer", "minimum": 1 },
    "state": { "enum": ["active", "revoked", "expired"] },
    "subscriptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "installation_id": { "type": "string", "format": "uuid" },
          "generation": { "type": "integer", "minimum": 1 },
          "state": { "enum": ["active", "revoked", "expired"] },
          "vapid_key_version": { "type": ["string", "null"] }
        },
        "required": ["installation_id", "generation", "state", "vapid_key_version"]
      }
    }
  },
  "required": ["ok", "schema_version"]
}
