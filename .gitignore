.DS_Store
__pycache__/
*.pyc
.venv/
out/
# ...and the bare name, because in a WORKTREE `out` is a SYMLINK to the
# canonical out/, and a trailing-slash pattern matches directories only —
# so the link itself showed up as untracked in every worktree (2026-08-10).
out
mcp-server/.neon
# ...and the ROOT one, which the Neon CLI writes beside it. 37 bytes, one
# field, `orgId` — the Neon organisation this checkout talks to, not a
# credential, and `neonctl` rewrites it on demand. Anchored so it ignores the
# repo-root file only and leaves the line above doing its own job.
/.neon
_to_delete/
*.bak-*

# PII never lives in this repo (Joe ruling (a), 2026-08-01; ORDER 42)
frozen-sources/
exporters/templates/

# PII output baselines — full file stays local, only sha256 tracked (ORDER 42b, 2026-08-06;
# renewal-radar.json added 2026-09-26 — tenant/landlord names, addresses and phones).
# See baselines/SHA256SUMS. Regenerate locally: tools/check.sh --out <name> tells you how.
baselines/lead-board.html
baselines/deal-room-panhandle.html
baselines/renewal-radar.json

# Encrypted DB dumps — archived to R2 instead of git (ORDER 42b, 2026-08-06). See bin/backup-dump.sh.
backups/*.sql.age

# Swift build artifacts — regenerated by bin/build-dictate.sh, never source
tools/dictation-rig/dictate/.build/

# Per-machine dictation vocab layer (WR-000049, 2026-09-24): real client,
# practice and person names for the whisper --prompt bias, split out of the
# tracked vocab-prompt.txt (which keeps only generic industry terms and place
# names) so a public clone never carries a client roster. Both
# transcribe_session.py's load_prompt() and Transcriber.swift's vocabPrompt
# load this file, if present, as a sibling of vocab-prompt.txt and append it.
tools/dictation-rig/vocab-local.txt

# Per-machine real-client fixture values for mcp-server/smoke-reads.sh's
# merge/tombstone regression checks (WR-000049, 2026-09-24) — see the
# fixture-externalization note near the top of that script.
mcp-server/smoke-reads.local.env

# The dossier roster (WR-000049): its keys are client names. Read by
# exporters/dossier_roster.py for exporters/targets.py, the import pipeline and
# hooks/record-home-gate.py. Per machine; never tracked.
exporters/dossier-roster.local.json

# The plain client-name list ops/githooks/client-name-warn.py reads for its
# warn-only pre-push note (WR-000049). Every line is a client name. Per machine;
# never tracked.
ops/config/client-names.local.txt

# Python virtualenvs — never source, and they carry >100MB binaries GitHub refuses
.venv/
.venv-*/
**/.venv-*/

# A bare .venv is usually a symlink into the primary checkout; the trailing-slash
# patterns above match directories only, so name it explicitly too.
.venv

# Claude Code worktrees — each is a live CHECKOUT of this repo (it carries its
# own .git file), not content of it. Untracked, they sat one `git add .` away
# from a nested-checkout commit, which is the sweep rule 308ef1de exists to
# stop. Added 2026-08-11 after two appeared during a live two-writer session.
.claude/worktrees/

# doc-convo run artifacts — a server log and a session id, regenerated on every
# run. The harvest-* corpus files beside them are deliberately NOT listed: that
# lane owns the call on whether they are source or output.
tools/doc-convo/assets/whisper-server.log
tools/doc-convo/assets/.harvest-brain-session-id

# Client deal material never enters this repo, private or not (Joe ruling (a),
# 2026-08-01, ORDER 42 — the same rule that keeps frozen-sources/ out). Packet
# generators embed the client's name and advisory prose addressed to them, the
# branded PDFs are the client's own documents, and the tmp-*-review folders are
# page renders of those documents. Finished client deliverables live in the
# Drive vault under Output/; scratch renders are staged in the vault _to_delete/.
# The patterns are deliberately generic: naming a client here would put the very
# identifier this rule exists to keep out into a tracked file.
build_*_carr_pdfs.py
tmp-*-review/
deliverables/*-carr-branded-*/
deliverables/*-pretour-*/
deliverables/*-packet-*/

# graphify code graph — regenerated by `graphify update ~/carr-system`, 17M of
# derived output. The GRAPH is not source; the command that rebuilds it is.
graphify-out/

# ops/ci-selftest.py's crash-recovery journal. Present only while a seeded
# defect is live in the tree, or after a run was killed before restoring it —
# the next run reads this, repairs every path it names, and refuses to start.
# Ignored rather than tracked because it holds the ORIGINAL BYTES of whatever it
# seeded, so a whole-tree staging command would commit the contents of arbitrary
# files. Recovery does not depend on it being visible to git: the selftest reads
# it directly.
_ci_selftest_seed_journal.json

# CARR Calendar Access.app: per-machine build artifacts (bin/build-calendar-access.sh).
# The ad-hoc signature verifies only on the Mac that made it and the compiled stub
# is arch-specific, so both are rebuilt locally rather than shipped in git.
tools/CARR Calendar Access.app/Contents/_CodeSignature/
tools/CARR Calendar Access.app/Contents/MacOS/carr-calendar-access
tools/.calendar-access-stub.sha256

# npm installs are per machine; mcp-server/package-lock.json is the review surface.
node_modules/

# Codex worktrees — the same class as .claude/worktrees/ above: each entry is a
# live CHECKOUT of this repo, not content of it. Two are in use (Graph-System
# and a phase4 continuity branch), so these are ignored, never removed.
.codex-worktrees/

# CI and selftest scratch trees. Named by convention (.tmp-*, and mktemp-suffixed
# selftest dirs), created per run, and never source. Added 2026-08-22: twelve of
# these had accumulated since 08-15 and made the health check's `loose-work` row
# amber every single night, which is how a row stops being read. Ignoring them
# leaves that row meaning what it says — the one loose path it still reports is
# a real one.
.tmp-*/
release-manifest-selftest-*/

# Per-machine tool caches, regenerated on demand and never source.
node-compile-cache/
xcrun_db

# doc-convo render daemon runtime files — a log and a pid, both rewritten on
# every run. Same lane as the whisper-server.log entry above.
tools/doc-convo/assets/render-daemon.log
tools/doc-convo/assets/.render-daemon.pid

# Local secrets files. No .env file is tracked (checked 2026-09-23); a
# committed .env.example template, if one is ever added, stays trackable.
.env
.env.*
!.env.example

# Rendered output. output/pdf/CARR-Tour-Packet-reference.pdf was tracked from
# #793 with no reader anywhere in the tree (untracked 2026-09-23). Rendered
# output is not source.
output/
