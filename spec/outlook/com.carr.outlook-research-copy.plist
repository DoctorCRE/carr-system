<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.carr.outlook-research-copy</string>
  <key>ProgramArguments</key>
  <array><string>{{HOME}}/carr-local/bin/outlook-research-copy</string></array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string></dict>
  <key>Umask</key><integer>63</integer>
  <key>StandardOutPath</key><string>{{HOME}}/carr-local/outlook-research-copy.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/carr-local/outlook-research-copy.log</string>
</dict>
</plist>
