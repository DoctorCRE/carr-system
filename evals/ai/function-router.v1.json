{
  "schema_version": 1,
  "artifact_type": "synthetic_read_only_router_policy",
  "data_class": "synthetic_only",
  "execution": "offline_deterministic",
  "calls_models": false,
  "writes_records": false,
  "allowed_actions": [],
  "routes": [
    {
      "tool_name": "find",
      "write": false,
      "full_only": false,
      "protection": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "tool_name": "catch-me-up",
      "write": false,
      "full_only": false,
      "protection": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "description": "L-204 / C-127 / V-CPA-006 / deal or party name"
          },
          "limit": {
            "type": "integer",
            "default": 20
          }
        },
        "required": [
          "ref"
        ]
      }
    },
    {
      "tool_name": "who-do-we-know",
      "write": false,
      "full_only": false,
      "protection": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "description": "who you want to reach \u2014 C-155, V-CPA-006, L-208, or a full name"
          },
          "max_depth": {
            "type": "integer",
            "description": "hops to walk, 1-3 (default 3)"
          },
          "limit": {
            "type": "integer",
            "description": "paths returned, capped at 25"
          }
        },
        "required": [
          "target"
        ]
      }
    },
    {
      "tool_name": "doctrine-index",
      "write": false,
      "full_only": false,
      "protection": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "content_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    {
      "tool_name": "search-doctrine",
      "write": false,
      "full_only": false,
      "protection": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "content_classes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "limit": {
            "type": "integer"
          }
        },
        "required": [
          "q"
        ]
      }
    },
    {
      "tool_name": "read-doctrine",
      "write": false,
      "full_only": false,
      "protection": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "document": {
            "type": "string",
            "description": "id, slug, or old slug (aliases resolve)"
          },
          "if_generation_match": {
            "type": "integer"
          }
        },
        "required": [
          "document"
        ]
      }
    },
    {
      "tool_name": "find-precedent",
      "write": false,
      "full_only": false,
      "protection": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "description": "the fork in a few concrete words — 'party merge survivor', 'markdown vs database', 'national account modelling'. Two or three specific nouns beat a full sentence: this is trigram matching, not a question answerer."
          },
          "limit": {
            "type": "integer",
            "description": "rulings returned, capped at 25 (default 8)"
          },
          "since": {
            "type": "string",
            "description": "ISO date; only rulings on or after it. Use when you want the CURRENT position rather than the whole history — an older ruling may have been superseded."
          }
        },
        "required": [
          "query"
        ]
      }
    },
    {
      "tool_name": "stale-records",
      "write": false,
      "full_only": false,
      "protection": "read_only",
      "input_schema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "tool_name": "today-triage",
      "write": false,
      "full_only": false,
      "protection": "read_only",
      "input_schema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "owners": {
            "type": "string",
            "enum": [
              "all",
              "partners"
            ]
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "cursor": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    }
  ],
  "denied_targets": [
    {
      "tool_name": "add-loop",
      "write": true,
      "full_only": false
    },
    {
      "tool_name": "read-work-shape",
      "write": false,
      "full_only": true
    }
  ]
}
