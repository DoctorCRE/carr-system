{
  "extraKnownMarketplaces": {
    "runpod": {
      "source": {
        "source": "github",
        "repo": "runpod/runpod-plugins-official"
      }
    }
  },
  "theme": "dark",
  "workflowSizeGuideline": "medium",
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENTS_PER_SESSION": "60",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "10",
    "CLAUDE_CODE_MAX_WEB_SEARCHES_PER_SESSION": "60"
  },
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "enabledPlugins": {
    "runpod@runpod": false
  },
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(./.venv/bin/python tools/ops-record.py *)",
      "Bash(git *)",
      "Bash(gh *)",
      "Bash(cd *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(awk *)",
      "Bash(sed *)",
      "Bash(cut *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(wc *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(printf *)",
      "Bash(date *)",
      "Bash(stat *)",
      "Bash(file *)",
      "Bash(which *)",
      "Bash(mkdir *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(chmod *)",
      "Bash(touch *)",
      "Bash(ln *)",
      "Bash(shasum *)",
      "Bash(md5 *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(realpath *)",
      "Bash(seq *)",
      "Bash(tr *)",
      "Bash(tee *)",
      "Bash(xargs *)",
      "Bash(jq *)",
      "Bash(curl *)",
      "Bash(python3 *)",
      "Bash(pip3 *)",
      "Bash(node *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(brew list *)",
      "Bash(psql *)",
      "Bash(pg_dump *)",
      "Bash(age *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(ffmpeg *)",
      "Bash(ffprobe *)",
      "Bash(yt-dlp *)",
      "Bash(whisper-cli *)",
      "Bash(textutil *)",
      "Bash(open *)",
      "Bash(launchctl list *)",
      "Bash(bash *)",
      "Bash(zsh *)",
      "Bash(sh *)",
      "Bash(~/carr-system/*)",
      "Bash(/Users/booko/carr-system/*)",
      "Bash(./run.sh *)",
      "Bash(./bin/*)",
      "Bash(./mcp-server/*)",
      "Bash(.venv/bin/python *)",
      "Read",
      "Edit",
      "Write",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(diskutil *)",
      "Bash(dd if=*)"
    ]
  },
  "skipWorkflowUsageWarning": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/guard-unattended.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*__(teach|activate-rule)",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/rule-shape-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/record-home-gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/gate-edit-gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/canonical-edit-gate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/one-repo-gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/close-before-open-gate.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/escalation-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/git-writer-gate.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/staging-attribution-gate.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/staging-observation-tracker.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/settings-change-gate.py"
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/bash-write-gate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/write-effect-check.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/draft-export-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/executor-tier-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash|mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/model-floor-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__claude-in-chrome__.*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/costar-lane-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__(record-defect|add-loop)",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/drift-claim-gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/escalation-gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/blocker-decider-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "PushNotification|mcp__.*__(send_message|create_draft|update_draft)",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/weekend-quiet-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "SendMessage",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/peer-broadcast-gate.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/lint-gate.py",
            "timeout": 40
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/staging-observation-tracker.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/settings-change-gate.py"
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/write-effect-check.py",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/map-architecture-gate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/conduct-stop-gate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/completion-evidence-gate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/ledger-sweep.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/context-handoff-gate.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/scheduled-run-record.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/chat-lint-gate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/loose-work-gate.py"
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/drift-assertion-gate.py",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/unread-artifact-gate.py",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/gate-integrity.py",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 /Users/booko/carr-system/hooks/chat-lint-carryover.py"
          }
        ]
      }
    ]
  }
}
