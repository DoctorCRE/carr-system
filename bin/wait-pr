#!/usr/bin/env python3
"""Wait up to 960 polls, 30 seconds apart, for merge/closure and optionally release.

Closed without merge exits 1. Exhausted retries exit 2. Live requires the exact
merge commit in a healthy, served production CARR release.
"""
import argparse
import http.client
import json
import re
import subprocess
import time
import urllib.request


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('repo')
    parser.add_argument('pr', type=int)
    parser.add_argument('target', choices=['merged', 'live'], nargs='?', default='merged')
    args = parser.parse_args()
    sha = None
    for attempt in range(960):
        if attempt:
            time.sleep(30)
        try:
            if sha is None:
                state, commit = subprocess.check_output(['gh', 'pr', 'view', str(args.pr),
                    '--repo', args.repo, '--json', 'state,mergeCommit', '--jq',
                    '[.state, .mergeCommit.oid // ""] | @tsv'], text=True, timeout=30).rstrip('\n').split('\t')
                if state == 'CLOSED':
                    print('CLOSED without merge')
                    return 1
                if state != 'MERGED' or not re.fullmatch(r'[0-9a-f]{40}', commit):
                    continue
                sha = commit
                if args.target == 'merged':
                    break
            request = urllib.request.Request('https://api.doctorcre.com/release',
                headers={'User-Agent': 'DoctorCRE-wait-pr/1.0'})
            with urllib.request.urlopen(request, timeout=30) as response:
                live = json.load(response)
                if (response.status == 200 and isinstance(live, dict)
                        and live.get('ok') is True
                        and isinstance(live.get('env'), dict)
                        and live['env'].get('value') == 'production'
                        and isinstance(live.get('git_sha'), dict)
                        and isinstance(live['git_sha'].get('value'), str)
                        and re.fullmatch(r'[0-9a-f]{40}', live['git_sha']['value'])
                        and live['git_sha']['value'] == sha):
                    break
        except (OSError, ValueError, KeyError, TypeError, http.client.HTTPException, subprocess.SubprocessError):
            continue
    else:
        print('Retry limit reached')
        return 2
    print(args.target.upper(), sha)
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
