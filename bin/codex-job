#!/usr/bin/env python3
"""Run one Codex job in a fresh clone; return its final message and exit code."""
import argparse
import contextlib
import codecs
import os
from pathlib import Path
import re
import signal
import shutil
import subprocess
import sys
import tempfile
import time


python = Path(__file__).resolve().parents[1] / '.venv/bin/python'
if python.is_file() and Path(sys.prefix) != python.parent.parent:
    os.execv(str(python), [str(python), __file__, *sys.argv[1:]])

from skill_picker import prepare


IDLE_SECONDS = 15 * 60
POLL_SECONDS = 5


def run_codex(command):
    active, offset, status = time.monotonic(), 0, None
    decoder = codecs.getincrementaldecoder('utf-8')(errors='replace')
    with tempfile.TemporaryFile() as output:
        child = subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=output,
                                 stderr=subprocess.STDOUT, start_new_session=True)
        pgid = child.pid
        try:
            while True:
                status = child.poll()
                data = os.pread(output.fileno(), os.fstat(output.fileno()).st_size - offset, offset)
                if data:
                    sys.stderr.write(decoder.decode(data))
                    sys.stderr.flush()
                    offset += len(data)
                    active = time.monotonic()
                if status is not None:
                    return status
                if time.monotonic() - active >= IDLE_SECONDS:
                    status = child.poll()
                    if status is not None:
                        continue
                    print('Codex stalled: no output for 15 minutes.', file=sys.stderr, flush=True)
                    return 124
                time.sleep(POLL_SECONDS)
        finally:
            if status != 0:
                handlers = {s: signal.signal(s, signal.SIG_IGN) for s in (signal.SIGTERM, signal.SIGINT)}
                try:
                    with contextlib.suppress(OSError):
                        os.killpg(pgid, signal.SIGTERM)
                    time.sleep(5)
                    with contextlib.suppress(OSError):
                        os.killpg(pgid, signal.SIGKILL)
                    with contextlib.suppress(OSError, subprocess.TimeoutExpired):
                        child.wait(timeout=5)
                finally:
                    for signum, handler in handlers.items():
                        signal.signal(signum, handler)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('repo', help='owner/repo, Git URL, or local Git repository')
    parser.add_argument('branch', help='new branch name')
    parser.add_argument('brief')
    parser.add_argument('-c', '--config', action='append', default=[], metavar='key=value')
    args = parser.parse_args()
    repo = args.repo
    if not Path(repo).exists() and re.fullmatch(r'[\w.-]+/[\w.-]+', repo):
        repo = f'https://github.com/{repo}.git'
    clone = Path(tempfile.mkdtemp(prefix='codex-job-')).resolve() / 'checkout'
    status = 1
    try:
        print(f'Clone: {clone}', file=sys.stderr, flush=True)
        subprocess.run(['git', 'clone', '--quiet', '--depth', '1', '--', repo, str(clone)],
                       check=True, stdin=subprocess.DEVNULL)
        subprocess.run(['git', '-C', str(clone), 'checkout', '--quiet', '-b', args.branch], check=True)
        subprocess.run(['git', '-C', str(clone), 'config', 'user.email',
                        'jbookout@users.noreply.github.com'], check=True)
        footer = Path(__file__).resolve().parents[1] / 'tools/room-bridge/brief-footer.md'
        brief, _ = prepare(args.brief + '\n\n' + footer.read_text(), clone)
        result = clone.parent / 'result.md'
        command = ['codex', 'exec', '-C', str(clone), '--dangerously-bypass-hook-trust',
                   '-o', str(result)]
        for config in args.config:
            command.extend(['-c', config])
        code = run_codex([*command, brief])
        if result.exists():
            print(result.read_text(), end='', flush=True)
        status = code
        return status
    finally:
        if status == 0 or not clone.exists():
            shutil.rmtree(clone.parent)
        else:
            print(f'Retained checkout: {clone}', file=sys.stderr, flush=True)


def terminate(signum, _frame):
    raise SystemExit(128 + signum)


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, terminate)
    signal.signal(signal.SIGINT, terminate)
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode)
