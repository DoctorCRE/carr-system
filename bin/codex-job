#!/usr/bin/env python3
"""Run one Codex job in a fresh clone; return its final message and exit code."""
import argparse
import os
from pathlib import Path
import re
import signal
import shutil
import subprocess
import sys
import tempfile
import time


python = Path(__file__).resolve().parents[1] / '.venv/bin/python'
if python.is_file() and Path(sys.prefix) != python.parent.parent:
    os.execv(str(python), [str(python), __file__, *sys.argv[1:]])

from skill_picker import prepare


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('repo', help='owner/repo, Git URL, or local Git repository')
    parser.add_argument('branch', help='new branch name')
    parser.add_argument('brief')
    parser.add_argument('-c', '--config', action='append', default=[], metavar='key=value')
    args = parser.parse_args()
    repo = args.repo
    if not Path(repo).exists() and re.fullmatch(r'[\w.-]+/[\w.-]+', repo):
        repo = f'https://github.com/{repo}.git'
    try:
        cutoff = time.time() - 2 * 24 * 60 * 60
        retained = [path for path in Path(tempfile.gettempdir()).glob('codex-job-*')
                    if not path.is_symlink() and (path / 'checkout' / '.git').is_dir()
                    and max(marker.stat().st_mtime
                            for marker in (path, path / 'checkout',
                                           path / 'checkout/.git/index',
                                           path / 'checkout/.git/logs/HEAD', path / 'result.md')
                            if marker.exists()) < cutoff]
        if retained:
            processes = subprocess.run(['ps', '-ww', '-axo', 'args='], check=True,
                                       capture_output=True, text=True, timeout=5).stdout
            active = []
            for line in processes.splitlines():
                if not re.search(r'(?:^|[/\s])codex(?:\s|$)', line.partition(' -')[0]):
                    continue
                match = re.search(r'(?:^|\s)(?:-C\s+|--cd(?:=|\s+))(.+)', line)
                if match:
                    locations = [Path(match[1][:end.start()].strip("\"'"))
                                 for end in re.finditer(r'\s+(?=-)|$', match[1])]
                    if not all(directory.is_absolute() for directory in locations):
                        raise ValueError('Cannot establish relative Codex checkout')
                    resolved = [directory.resolve(strict=True) for directory in locations
                                if directory.is_dir()]
                    if not resolved:
                        raise ValueError('Cannot establish Codex checkout')
                    active.extend(resolved)
            for path in retained:
                if not any(directory.is_relative_to(path.resolve()) for directory in active):
                    shutil.rmtree(path)
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    workspace = Path(tempfile.mkdtemp(prefix='codex-job-'))
    clone = workspace / 'checkout'
    status, cloned = 1, False
    try:
        print(f'Clone: {clone}', file=sys.stderr, flush=True)
        subprocess.run(['git', 'clone', '--quiet', '--depth', '1', '--', repo, str(clone)],
                       check=True, stdin=subprocess.DEVNULL)
        cloned = True
        subprocess.run(['git', '-C', str(clone), 'checkout', '--quiet', '-b', args.branch], check=True)
        subprocess.run(['git', '-C', str(clone), 'config', 'user.email',
                        'jbookout@users.noreply.github.com'], check=True)
        brief, _ = prepare(args.brief, clone)
        result = clone.parent / 'result.md'
        command = ['codex', 'exec', '-C', str(clone), '--dangerously-bypass-hook-trust',
                   '-o', str(result)]
        for config in args.config:
            command.extend(['-c', config])
        child = subprocess.Popen([*command, brief], stdin=subprocess.DEVNULL,
                                 stdout=sys.stderr, start_new_session=True)
        pgid = child.pid
        try:
            code = child.wait()
        finally:
            try:
                os.killpg(pgid, signal.SIGTERM)
                try:
                    time.sleep(0.2)
                finally:
                    os.killpg(pgid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            finally:
                child.wait()
        status = code
        if result.exists():
            try:
                print(result.read_text(), end='', flush=True)
            except BrokenPipeError:
                with open(os.devnull, 'w') as sink:
                    os.dup2(sink.fileno(), sys.stdout.fileno())
        return status
    finally:
        if status == 0 or not cloned:
            shutil.rmtree(workspace)
        else:
            print(f'Retained checkout: {clone}', file=sys.stderr, flush=True)


def terminate(signum, _frame):
    raise SystemExit(128 + signum)


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, terminate)
    signal.signal(signal.SIGINT, terminate)
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode)
