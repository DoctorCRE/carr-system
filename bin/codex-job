#!/usr/bin/env python3
"""Run one Codex job in a fresh clone; return its final message and exit code."""
import argparse
import contextlib
import fcntl
import os
import json
import tomllib
from uuid import NAMESPACE_URL, uuid5
from pathlib import Path
import re
import signal
import runpy
import stat
import shutil
import subprocess
import sys
import tempfile
import time


python = Path(__file__).resolve().parents[1] / '.venv/bin/python'
if python.is_file() and Path(sys.prefix) != python.parent.parent:
    os.execv(str(python), [str(python), __file__, *sys.argv[1:]])

from skill_picker import prepare


def job_log():
    """The file this job's output is redirected to: its transcript for attach-memory, made owner-only."""
    try:
        if not stat.S_ISREG(os.fstat(2).st_mode):
            return None
        with contextlib.suppress(OSError):
            os.fchmod(2, 0o600)
        if sys.platform == 'darwin':
            return os.fsdecode(fcntl.fcntl(2, fcntl.F_GETPATH, bytes(1024)).rstrip(b'\0'))
        return os.readlink('/proc/self/fd/2')
    except OSError:
        return None


def output(argv, **options):
    """A lookup's stdout, or None when it could not answer."""
    try:
        done = subprocess.run(argv, capture_output=True, text=True, stdin=subprocess.DEVNULL,
                              timeout=120, **options)
    except (OSError, subprocess.SubprocessError):
        return None
    return done.stdout if done.returncode == 0 else None


def delivery(clone, branch, start):
    """Did the job push a new commit as a branch tip and open a PR for that branch?

    A job that exits cleanly without either loses its work (2026-10-28 retro: the
    round-2 fix for #2624 reported success but never pushed), so the clone's final
    HEAD is checked on the remote rather than trusted from the job's own report.
    Jobs may push to an existing PR's branch, so any branch whose tip is HEAD counts.
    """
    head = (output(['git', '-C', str(clone), 'rev-parse', 'HEAD']) or '').strip()
    listing = output(['git', '-C', str(clone), 'ls-remote', '--heads', 'origin'])
    tips = [ref.removeprefix('refs/heads/') for sha, ref in
            (line.split('\t', 1) for line in (listing or '').splitlines())
            if sha == head and head not in ('', start)]
    found = branch if branch in tips else next(iter(tips), None)
    pushed = found is not None
    pr = 'unchecked'
    if pushed:
        url = output(['gh', 'pr', 'list', '--head', found, '--state', 'all',
                      '--json', 'url', '--jq', '.[0].url // empty'], cwd=clone)
        pr = 'unchecked' if url is None else url.strip() or 'none'
    missing = [name for name, gap in (('push', not pushed), ('pr', pr in ('unchecked', 'none'))) if gap]
    return missing, (f"Delivery: {'failed' if missing else 'ok'} missing={','.join(missing) or 'none'} "
                     f"branch={found or ('unchecked' if listing is None else 'none')} "
                     f'start={start} head={head or "unchecked"} pr={pr}')


def register_job(args):
    line = next((line for line in args.brief.splitlines() if line.startswith('Card:')), '')
    card = line.removeprefix('Card:').strip() or '<missing>'
    try:
        match = re.fullmatch(r'WR([1-9]\d*)\.S([1-9]\d*)\.J([1-9]\d*)', card)
        if not match or any(int(number) > 0x7fffffff for number in match.groups()[1:]):
            raise ValueError('requires Card: WRn.Sm.Jk')
        headers = {}
        for header in ('Title', 'Description'):
            value = next((line.removeprefix(header + ':').strip()
                          for line in args.brief.splitlines() if line.startswith(header + ':')), '')
            if not value:
                print(f'codex-job: {card}: brief requires {header}: header', file=sys.stderr)
                return False
            headers[header] = value
        repository = args.repo
        if Path(repository).exists():
            repository = output(['git', '-C', repository, 'remote', 'get-url', 'origin']) or ''
        repository = re.sub(r'^(?:https://github.com/|git@github[.]com:)', '', repository.strip()).removesuffix('.git')
        settings_path = Path(os.environ.get('CODEX_HOME', str(Path.home() / '.codex'))) / 'config.toml'
        settings = tomllib.loads(settings_path.read_text()) if settings_path.exists() else {}
        for config in args.config:
            key, separator, value = config.partition('=')
            if separator and key in ('model', 'model_reasoning_effort'):
                settings[key] = value.strip('"\'')
        runner = 'codex-' + str(uuid5(NAMESPACE_URL, repository + '/' + args.branch))
        facts = dict(idempotency_key=str(uuid5(NAMESPACE_URL, card + '/' + runner)),
                     work_request=f'WR-{int(match[1]):06d}', slice=int(match[2]), job=int(match[3]),
                     runner_job_id=runner, repository=repository, executor='codex',
                     model=settings.get('model', 'default'), effort=settings.get('model_reasoning_effort', 'default'),
                     card_title=headers['Title'], description=headers['Description'])
        reply = output([sys.executable, str(Path(__file__).resolve().parents[1] / 'tools/call-verb.py'),
                        'dispatch-job', json.dumps(facts)])
        receipt = json.loads(reply or '{}')
        if not isinstance(receipt, dict) or receipt.get('ok') is not True or receipt.get('card_id') != card or receipt.get('runner_job_id') != runner:
            raise ValueError('dispatch-job refused registration')
    except (OSError, ValueError, TypeError):
        print(f'codex-job: {card}: job registration refused', file=sys.stderr)
        return False
    return True


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('repo', help='owner/repo, Git URL, or local Git repository')
    parser.add_argument('branch', help='new branch name')
    parser.add_argument('brief')
    parser.add_argument('-c', '--config', action='append', default=[], metavar='key=value')
    parser.add_argument("--timeout-seconds", type=int, default=10800, help="wall-clock cap (default: 3 hours)")
    args = parser.parse_args()
    if args.timeout_seconds <= 0:
        parser.error("--timeout-seconds must be positive")
    if not register_job(args):
        return 1
    timeout = runpy.run_path(str(Path(__file__).with_name("with-timeout.py")))
    repo = args.repo
    if not Path(repo).exists() and re.fullmatch(r'[\w.-]+/[\w.-]+', repo):
        repo = f'https://github.com/{repo}.git'
    try:
        cutoff = time.time() - 2 * 24 * 60 * 60
        retained = [path for path in Path(tempfile.gettempdir()).glob('codex-job-*')
                    if not path.is_symlink() and (path / 'checkout' / '.git').is_dir()
                    and max(marker.stat().st_mtime
                            for marker in (path, path / 'checkout',
                                           path / 'checkout/.git/index',
                                           path / 'checkout/.git/logs/HEAD', path / 'result.md')
                            if marker.exists()) < cutoff]
        if retained:
            processes = subprocess.run(['ps', '-ww', '-axo', 'args='], check=True,
                                       capture_output=True, text=True, timeout=5).stdout
            active = []
            for line in processes.splitlines():
                if not re.search(r'(?:^|[/\s])codex(?:\s|$)', line.partition(' -')[0]):
                    continue
                match = re.search(r'(?:^|\s)(?:-C\s+|--cd(?:=|\s+))(.+)', line)
                if match:
                    locations = [Path(match[1][:end.start()].strip("\"'"))
                                 for end in re.finditer(r'\s+(?=-)|$', match[1])]
                    if not all(directory.is_absolute() for directory in locations):
                        raise ValueError('Cannot establish relative Codex checkout')
                    resolved = [directory.resolve(strict=True) for directory in locations
                                if directory.is_dir()]
                    if not resolved:
                        raise ValueError('Cannot establish Codex checkout')
                    active.extend(resolved)
            for path in retained:
                if not any(directory.is_relative_to(path.resolve()) for directory in active):
                    shutil.rmtree(path)
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    workspace = Path(tempfile.mkdtemp(prefix='codex-job-'))
    clone = workspace / 'checkout'
    status, cloned = 1, False
    try:
        print(f'Clone: {clone}', file=sys.stderr, flush=True)
        subprocess.run(['git', 'clone', '--quiet', '--depth', '1', '--', repo, str(clone)],
                       check=True, stdin=subprocess.DEVNULL)
        cloned = True
        subprocess.run(['git', '-C', str(clone), 'checkout', '--quiet', '-b', args.branch], check=True)
        start = subprocess.run(['git', '-C', str(clone), 'rev-parse', 'HEAD'], check=True,
                               capture_output=True, text=True).stdout.strip()
        subprocess.run(['git', '-C', str(clone), 'config', 'user.email',
                        'jbookout@users.noreply.github.com'], check=True)
        brief, _ = prepare(args.brief, clone)
        log = job_log()
        brief = (f'Job log: {log} (pass it to attach-memory as transcript_ref).' if log
                 else 'Job log: none (stderr is not a file).') + '\n\n' + brief
        result = clone.parent / 'result.md'
        command = ['codex', 'exec', '-C', str(clone), '--dangerously-bypass-hook-trust',
                   '-o', str(result)]
        for config in args.config:
            command.extend(['-c', config])
        child = subprocess.Popen([*command, brief], stdin=subprocess.DEVNULL,
                                 stdout=sys.stderr, start_new_session=True)
        pgid = child.pid
        try:
            try:
                code = child.wait(timeout=args.timeout_seconds)
            except subprocess.TimeoutExpired:
                timeout["_terminate_group"](child)
                code = 124
        finally:
            try:
                os.killpg(pgid, signal.SIGTERM)
                try:
                    time.sleep(0.2)
                finally:
                    os.killpg(pgid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            finally:
                child.wait()
        missing, report = delivery(clone, args.branch, start)
        status = code or int(bool(missing))
        try:
            if result.exists():
                print(result.read_text(), end='', flush=True)
            print(report, flush=True)
        except BrokenPipeError:
            with open(os.devnull, 'w') as sink:
                os.dup2(sink.fileno(), sys.stdout.fileno())
        return status
    finally:
        if status == 0 or not cloned:
            shutil.rmtree(workspace)
        else:
            print(f'Retained checkout: {clone}', file=sys.stderr, flush=True)


def terminate(signum, _frame):
    raise SystemExit(128 + signum)


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, terminate)
    signal.signal(signal.SIGINT, terminate)
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode)
