#!/usr/bin/env python3
"""Run one Codex job in a fresh clone; return its final message and exit code."""
import argparse
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile


python = Path(__file__).resolve().parents[1] / '.venv/bin/python'
if python.is_file() and Path(sys.prefix) != python.parent.parent:
    os.execv(str(python), [str(python), __file__, *sys.argv[1:]])

from skill_picker import prepare


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('repo', help='owner/repo, Git URL, or local Git repository')
    parser.add_argument('branch', help='new branch name')
    parser.add_argument('brief')
    parser.add_argument('-c', '--config', action='append', default=[], metavar='key=value')
    args = parser.parse_args()
    repo = args.repo
    if not Path(repo).exists() and re.fullmatch(r'[\w.-]+/[\w.-]+', repo):
        repo = f'https://github.com/{repo}.git'
    with tempfile.TemporaryDirectory(prefix='codex-job-') as workspace:
        clone = Path(workspace) / 'checkout'
        print(f'Clone: {clone}', file=sys.stderr, flush=True)
        subprocess.run(['git', 'clone', '--quiet', '--depth', '1', '--', repo, str(clone)],
                       check=True, stdin=subprocess.DEVNULL)
        subprocess.run(['git', '-C', str(clone), 'checkout', '--quiet', '-b', args.branch], check=True)
        subprocess.run(['git', '-C', str(clone), 'config', 'user.email',
                        'jbookout@users.noreply.github.com'], check=True)
        brief, _ = prepare(args.brief, clone)
        result = clone.parent / 'result.md'
        command = ['codex', 'exec', '-C', str(clone), '--dangerously-bypass-hook-trust',
                   '-o', str(result)]
        for config in args.config:
            command.extend(['-c', config])
        run = subprocess.run([*command, '--', brief], stdin=subprocess.DEVNULL, stdout=sys.stderr)
        if result.exists():
            print(result.read_text(), end='', flush=True)
        return run.returncode


def terminate(signum, _frame):
    raise SystemExit(128 + signum)


if __name__ == '__main__':
    signal.signal(signal.SIGTERM, terminate)
    try:
        raise SystemExit(main())
    except subprocess.CalledProcessError as error:
        raise SystemExit(error.returncode)
