{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CARR_MCP_CLIENT_PROFILE=claude-continuity /usr/bin/env python3 {{REPO}}/ops/claude-continuity-hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|compact|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "CARR_MCP_CLIENT_PROFILE=claude-continuity /usr/bin/env python3 {{REPO}}/ops/claude-continuity-hook.py",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
