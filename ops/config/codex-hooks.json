{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/rule-boot-gate.py",
            "timeout": 5,
            "additionalContextLimit": 5000
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/rule-pack-preuse-reselection.py",
            "timeout": 20,
            "additionalContextLimit": 5000
          }
        ]
      },
      {
        "matcher": "^(Bash|exec_command|functions\\.exec)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/guard-unattended.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "mcp__.*__teach",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/rule-shape-gate.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(apply_patch|functions\\.apply_patch)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/record-home-gate.py",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/close-before-open-gate.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "^(Bash|exec_command|Read|Grep|Glob|WebFetch|apply_patch|functions\\.(exec|apply_patch)|mcp__(carr|carr_records)__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/delegation-gate.py",
            "timeout": 3
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|mcp__.*__standing[-_]context",
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/rule-boot-gate.py",
            "timeout": 5,
            "additionalContextLimit": 5000
          }
        ]
      },
      {
        "matcher": "^(Write|Edit|MultiEdit|apply_patch|functions\\.(apply_patch|exec))$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/lint-gate.py",
            "timeout": 40
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CARR_MCP_CLIENT_PROFILE=codex-continuity /usr/bin/env python3 {{REPO}}/ops/codex-continuity-hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CARR_MCP_CLIENT_PROFILE=codex-continuity /usr/bin/env python3 {{REPO}}/ops/codex-continuity-hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/gate-integrity.py",
            "timeout": 15,
            "additionalContextLimit": 5000
          }
        ]
      },
      {
        "matcher": "^(startup|resume|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "CARR_MCP_CLIENT_PROFILE=codex-continuity /usr/bin/env python3 {{REPO}}/ops/codex-continuity-hook.py",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/session-presence-hook.py codex",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/session-presence-hook.py codex",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/rule-pack-preuse-reselection.py",
            "timeout": 20
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "CARR_MCP_CLIENT_PROFILE=codex-continuity /usr/bin/env python3 {{REPO}}/ops/codex-continuity-hook.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/map-architecture-gate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/completion-evidence-gate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/ledger-sweep.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "/usr/bin/env python3 {{REPO}}/hooks/chat-lint-gate.py",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/hook-meter-run.py {{REPO}}/hooks/rule-pack-drift-gate.py",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
