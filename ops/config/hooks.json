{
  "PreToolUse": [
    {
      "matcher": ".*",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/rule-boot-gate.py",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit|Agent|WebFetch|WebSearch|Artifact|AskUserQuestion|EnterPlanMode|UpdatePlan|update_plan|functions\\.update_plan|mcp__.*",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/rule-pack-preuse-reselection.py",
          "timeout": 20
        }
      ]
    },
    {
      "matcher": "Bash|WebFetch",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/guard-unattended.py",
          "timeout": 15
        }
      ]
    },
    {
      "matcher": "Write|Edit|MultiEdit",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/record-home-gate.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/one-repo-gate.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/canonical-edit-gate.py",
          "timeout": 15
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/bash-write-gate.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/write-effect-check.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/draft-export-gate.py",
          "timeout": 10
        },
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/github-burst-guard.py",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Agent",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/executor-tier-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "Bash|mcp__claude-in-chrome__.*",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/model-floor-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "mcp__claude-in-chrome__.*",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/costar-lane-gate.py",
          "timeout": 10
        }
      ]
    },
    {
      "matcher": "PushNotification|mcp__.*__(send_message|create_draft|update_draft)",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/weekend-quiet-gate.py",
          "timeout": 10
        }
      ]
    }
  ],
  "PostToolUse": [
    {
      "matcher": "Write|Edit|MultiEdit|apply_patch|functions\\.apply_patch",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/lint-gate.py",
          "timeout": 40
        }
      ]
    },
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/write-effect-check.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/github-burst-guard.py",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Bash|mcp__.*__standing-context",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/rule-boot-gate.py",
          "timeout": 5
        }
      ]
    }
  ],
  "PostToolUseFailure": [
    {
      "matcher": "Bash",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/github-burst-guard.py",
          "timeout": 5
        }
      ]
    },
    {
      "matcher": "Bash|mcp__.*__standing-context",
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/rule-boot-gate.py",
          "timeout": 5
        }
      ]
    }
  ],
  "PreCompact": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "CARR_CONTEXT_HOOK_EVENT=PreCompact {{REPO}}/.venv/bin/python {{REPO}}/hooks/context-handoff-gate.py",
          "timeout": 20
        }
      ]
    }
  ],
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "CARR_CONTEXT_HOOK_EVENT=Stop {{REPO}}/.venv/bin/python {{REPO}}/hooks/context-handoff-gate.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/scheduled-run-record.py",
          "timeout": 20
        },
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/rule-pack-drift-gate.py",
          "timeout": 20
        }
      ]
    }
  ],
  "SessionStart": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/gate-integrity.py",
          "timeout": 15
        },
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/rule-boot-gate.py",
          "timeout": 5
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/session-presence-hook.py claude",
          "timeout": 5
        }
      ]
    }
  ],
  "SessionEnd": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/session-presence-hook.py claude",
          "timeout": 5
        }
      ]
    }
  ],
  "UserPromptSubmit": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/job-watchdog-digest.py",
          "timeout": 5
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/session-presence-hook.py claude",
          "timeout": 5
        }
      ]
    },
    {
      "hooks": [
        {
          "type": "command",
          "command": "{{REPO}}/.venv/bin/python {{REPO}}/hooks/rule-pack-preuse-reselection.py",
          "timeout": 20
        }
      ]
    }
  ]
}
