{
  "schema_version": 1,
  "protected_branches": [
    "main",
    "master",
    "develop"
  ],
  "repositories": [
    "jbookout/carr-system",
    "jbookout/doctorcre-app",
    "jbookout/software-factory"
  ],
  "repository_roots": {
    "jbookout/carr-system": "~/carr-system",
    "jbookout/doctorcre-app": "~/doctorcre-app",
    "jbookout/software-factory": "~/software-factory"
  },
  "board": "carr-v5",
  "board_github_enabled": false,
  "machine_cleanup": {
    "checkout_age_seconds": 604800,
    "thread_age_seconds": 172800,
    "max_seconds": 240,
    "max_items": 200,
    "test_temp_age_seconds": 21600,
    "test_temp_max_items": 1000
  },
  "thresholds": {
    "branch_idle_seconds": 10800,
    "command_timeout_seconds": 30,
    "kill_grace_seconds": 5,
    "process_probe_seconds": 5,
    "log_tail_bytes": 16384
  },
  "paths": {
    "registry": "out/jobs/registry.jsonl",
    "job_logs": "out/jobs/logs"
  },
  "next_actions": {
    "job_failed": "Read the recorded exit and log tail; repair the failing command."
  }
}
