<?xml version="1.0" encoding="UTF-8"?>
<!-- doctrine: studio-macbook-failover -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.carr.cliproxyapi</string>
	<key>ProgramArguments</key>
	<array>
		<string>/opt/homebrew/opt/cliproxyapi/bin/cliproxyapi</string>
		<string>-config</string>
		<string>{{HOME}}/.cli-proxy-api/config.yaml</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/cliproxyapi.err.log</string>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/cliproxyapi.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
	</dict>
</dict>
</plist>
