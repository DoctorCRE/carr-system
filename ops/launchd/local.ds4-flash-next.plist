<?xml version="1.0" encoding="UTF-8"?>
<!-- doctrine: studio-macbook-failover -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>Label</key>
	<string>local.ds4-flash-next</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{HOME}}/src/ds4-main/ds4-server</string>
		<string>--ctx</string>
		<string>131072</string>
		<string>--prefill-chunk</string>
		<string>1024</string>
		<string>--mtp</string>
		<string>--host</string>
		<string>127.0.0.1</string>
		<string>--port</string>
		<string>8000</string>
		<string>--kv-disk-dir</string>
		<string>{{HOME}}/.ds4/server-kv</string>
		<string>--kv-disk-space-mb</string>
		<string>16384</string>
		<string>--kv-cache-cold-max-tokens</string>
		<string>40000</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/ds4-flash-next.log</string>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/ds4-flash-next.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
	<key>WorkingDirectory</key>
	<string>{{HOME}}/src/ds4-main</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
	</dict>
</dict>
</plist>
