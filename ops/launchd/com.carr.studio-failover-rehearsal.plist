<?xml version="1.0" encoding="UTF-8"?>
<!-- doctrine: studio-macbook-failover -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.carr.studio-failover-rehearsal</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>{{REPO}}/ops/rehearse-studio-failover.sh</string>
  </array>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <key>StartCalendarInterval</key><dict>
    <key>Day</key><integer>5</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>15</integer>
  </dict>
  <key>StandardOutPath</key><string>{{REPO}}/out/studio-failover/rehearsal.log</string>
  <key>StandardErrorPath</key><string>{{REPO}}/out/studio-failover/rehearsal-error.log</string>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string></dict>
</dict></plist>
