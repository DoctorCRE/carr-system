<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.carr.cc-version-sentinel</string>

  <!-- THE FREE HALF OF THE CLAUDE CODE UPDATE AUDIT (loop #177).

       The cc-update-audit scheduled task fired five times a week and exited in
       seconds on most of them, because its first step is a string comparison.
       A session that exits in seconds still pays a full session boot. The cost
       model loop #177 established: a script costs nothing, a session costs
       tokens, so mechanical work belongs in a script and sessions are reserved
       for judgment.

       This agent runs the GATE hourly for free and notifies Joe within the hour
       when either Claude Code binary moves. The AUDIT — read the real changelog,
       work out what the release changes for CARR, delegate to IT Support — stays
       a session, and its schedule drops from five fires a week to one, because
       the sentinel now carries the detection latency and the audit task already
       scopes itself across every release stacked since its last run.

       RISK COLOR: GREEN. Reads two version strings, writes a marker and a log
       line, raises a local notification. No verb, no record, no network,
       nothing leaves this Mac. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/run-scheduled.sh</string>
    <string>cc-version-sentinel</string>
    <string>launchd.run</string>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/cc-version-sentinel.sh</string>
  </array>

  <!-- Hourly. The desktop app can update mid-day and that runtime is the one
       executing Joe's sessions, so a daily check would leave him working on an
       unaudited runtime for most of a day. -->
  <!-- carr-launchd-interval-seconds: 3600 | rendered by lib/launchd_calendar.py; macOS 27 launchd never fires StartInterval -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>19</integer></dict>
  </array>

  <!-- Catch an update that landed while the Mac was asleep or shut, rather than
       waiting for the next hour boundary. -->
  <key>RunAtLoad</key><true/>
  <key>ThrottleInterval</key><integer>60</integer>

  <key>StandardOutPath</key><string>{{REPO}}/out/cc-version-sentinel.out</string>
  <key>StandardErrorPath</key><string>{{REPO}}/out/cc-version-sentinel.err</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
