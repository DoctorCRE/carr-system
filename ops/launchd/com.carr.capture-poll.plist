<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        WO-4 capture bridge, poll side. Sweeps ~/Recordings every 5 minutes
        for sessions that hold a live .capture.json (already claimed) but no
        ingested.json yet, and asks the worker whether a meeting_record has
        landed for each one. RunAtLoad true so a Mac restart or a fresh
        install doesn't wait a full interval before the first sweep.

        This plist references the DURABLE main-checkout path, not the
        wo4-capture-bridge build worktree — see the identical note in
        com.carr.dictation-consent.plist.
    -->
    <key>Label</key>
    <string>com.carr.capture-poll</string>

    <!-- Program 4 follow-up: the heartbeat interval flag below (spelled out in
         ProgramArguments, not here: a double hyphen is illegal inside an XML
         comment, the same defect PR #97 fixed once already for the scheduled
         flag on notes-sweep's own plist) throttles the succeeded row to at
         most one per 1800s (30 min): recording all ~288 fires/day would be
         noise from a quiet inbox. A failure is still recorded immediately
         regardless (see ops/config/services.json's own note on this
         service's retuned cadence). -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>{{REPO}}/bin/run-scheduled.sh</string>
        <string>--heartbeat-interval</string>
        <string>1800</string>
        <string>capture-poll</string>
        <string>launchd.run</string>
        <string>{{REPO}}/tools/dictation-rig/bin/capture-poll.sh</string>
      </array>

    <!-- carr-launchd-interval-seconds: 300 | rendered by lib/launchd_calendar.py; macOS 27 launchd never fires StartInterval -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>5</integer></dict>
        <dict><key>Minute</key><integer>10</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>20</integer></dict>
        <dict><key>Minute</key><integer>25</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>35</integer></dict>
        <dict><key>Minute</key><integer>40</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
        <dict><key>Minute</key><integer>50</integer></dict>
        <dict><key>Minute</key><integer>55</integer></dict>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/capture-bridge.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/capture-bridge.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
