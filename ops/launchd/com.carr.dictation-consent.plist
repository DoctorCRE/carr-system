<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.carr.dictation-consent</string>

    <!--
        This plist references the DURABLE main-checkout path, not the
        dictation-rig build worktree it was authored in. tools/dictation-rig
        merges into ~/carr-system at {{REPO}}/tools/dictation-rig/,
        and that is the path launchd must run from, since the worktree is
        temporary and disappears once the branch merges.
    -->
    <!--
        WRAPPED DELIBERATELY, AND IT MUST STAY WRAPPED (commit 4fb58a8a).
        dictation-consent is registered criticality HIGH despite being a small
        watcher: it is what makes the rig announce recording aloud, Florida is
        an all-party-consent state, and a failure here is legal exposure rather
        than inconvenience. Each firing is a discrete run worth recording, so
        the wrapper is what makes a failure durable instead of leaving it in a
        launchd log on one Mac. bin/run-scheduled.sh is transparent by
        construction — verbatim child exit code, untouched stdout and stderr,
        the caller's cwd, arguments passed through unsplit, and recorder
        failures that never reach the job's log or exit code; each of those is
        a check in ops/run-scheduled-selftest.py.

        WATCH OUT: `ops/config-as-code.py pull` will try to delete these four
        wrapper lines any time the LIVE copy is installed unwrapped, because it
        faithfully captures whatever the machine has. That is drift being
        recorded, not a correction. Re-install from this file instead of
        pulling the wrapper away.
    -->
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>{{REPO}}/bin/run-scheduled.sh</string>
        <string>dictation-consent</string>
        <string>launchd.run</string>
        <string>{{REPO}}/tools/dictation-rig/bin/consent-watch.sh</string>
      </array>

    <!--
        WatchPaths fires on directory-entry changes inside ~/Recordings
        itself — i.e. a new session directory being created the moment quill
        starts recording (quill has no CLI start command; this is the only
        hook point). It may also fire again when the session directory's
        contents change at stop (meta.json appears); that's harmless because
        consent-watch.sh is idempotent per session via announcement.json.
    -->
    <key>WatchPaths</key>
    <array>
        <string>{{HOME}}/Recordings</string>
    </array>

    <!--
        Coalesce rapid-fire filesystem events (mic.caf/system.caf growing
        during recording, meta.json + announcement.json appearing) into at
        most one run per second, so a live recording session doesn't spawn a
        flood of watcher invocations.
    -->
    <key>ThrottleInterval</key>
    <integer>1</integer>

    <!--
        The five-minute calendar tick exists for the STILL-RECORDING reminder, and WatchPaths
        cannot serve it: WatchPaths fires on changes to ~/Recordings' own
        directory entries, so a session directory appearing or being renamed
        wakes us, but mic.caf growing INSIDE that subdirectory does not. A
        recording therefore produces exactly one event at start and one at
        stop. On 2026-08-17 that silence let meeting mode run 52 minutes past
        intent. This tick is what lets consent-watch.sh speak again while a
        session is still hot; the run is a cheap directory scan that exits 0
        when nothing is recording.
    -->
    <!-- carr-launchd-interval-seconds: 300 | rendered by lib/launchd_calendar.py; macOS 27 launchd never fires StartInterval -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>5</integer></dict>
        <dict><key>Minute</key><integer>10</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>20</integer></dict>
        <dict><key>Minute</key><integer>25</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>35</integer></dict>
        <dict><key>Minute</key><integer>40</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
        <dict><key>Minute</key><integer>50</integer></dict>
        <dict><key>Minute</key><integer>55</integer></dict>
    </array>

    <key>StandardOutPath</key>
    <string>{{REPO}}/out/dictation-consent.log</string>

    <key>StandardErrorPath</key>
    <string>{{REPO}}/out/dictation-consent.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
