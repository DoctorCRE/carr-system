  </array>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>{{REPO}}/out/job-watchdog.log</string>
  <key>StandardErrorPath</key><string>{{REPO}}/out/job-watchdog.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CARR_REPO</key><string>{{REPO}}</string>
  </dict>
</dict>
</plist>
