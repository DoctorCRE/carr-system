<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hourly machine cleanup on every Mac. The watchdog bounds the entire process group.
     The fleet installer renders this template against each machine's canonical checkout. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carr.storage-hygiene</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/run-scheduled.sh</string>
    <string>storage-hygiene</string>
    <string>launchd.run</string>
    <string>{{REPO}}/.venv/bin/python</string>
    <string>{{REPO}}/tools/job-watchdog.py</string>
    <string>run</string>
    <string>storage-hygiene</string>
    <string>machine cleanup</string>
    <string>5</string>
    <string>--</string>
    <string>{{REPO}}/.venv/bin/python</string>
    <string>{{REPO}}/tools/storage_hygiene.py</string>
    <string>--machine</string>
    <string>--max-seconds</string>
    <string>240</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{REPO}}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>19</integer></dict>
  </array>

  <key>RunAtLoad</key><false/>
  <key>ThrottleInterval</key><integer>60</integer>

  <key>StandardOutPath</key>
  <string>{{REPO}}/out/storage-hygiene.log</string>
  <key>StandardErrorPath</key>
  <string>{{REPO}}/out/storage-hygiene.log</string>
</dict>
</plist>
