<?xml version="1.0" encoding="UTF-8"?>
<!--
  com.carr.partner-ping — buzz this partner when the OTHER one needs them.

  Install (per machine, once):
    ./.venv/bin/python ops/config-as-code.py install
    # set CARR_PARTNER below to joe or dell FIRST — it is the one machine-specific
    # value, and a wrong one makes the watcher silently watch the wrong partner

  NOT `cp` — THIS FILE IS A SOURCE, NOT AN INSTALLABLE. It stores {{REPO}}
  rather than your HOME directory so the same plist installs on Dell's machine, and
  config-as-code renders that placeholder on the way out. Copying it by hand
  installs a LaunchAgent whose program path is the literal string {{REPO}}.
  This line used to read `cp ops/com.carr.partner-ping.plist`, naming a stale
  duplicate that sat outside ops/launchd/ and was last touched at its first
  commit — it never gained the run-scheduled.sh wrapper, the heartbeat flags or
  the weekday-window flag described further down. That duplicate was deleted
  2026-08-23 by the process-audit council's dead-weight sweep; ops/launchd/ is
  the only home.

  (No double hyphen appears anywhere in this comment, for the reason the
  ProgramArguments note below spells out. Writing one here made this file
  unparseable by plistlib while launchd accepted it — caught immediately by
  ops/launchd-plist-portable-selftest.py, which is why that suite exists.)

  Stop it:
    launchctl unload ~/Library/LaunchAgents/com.carr.partner-ping.plist

  Runs every 120s. It is a single SQL query plus a notification, not a Claude
  session, which is the whole reason it can run this often without costing
  anything. Do not convert this into a routine — see the header of
  pipelines/partner_ping.py for why that would be ~288 agent runs a day.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carr.partner-ping</string>

  <!-- Program 4 follow-up: the two flags below (spelled out in
       ProgramArguments, not here: a double hyphen is illegal inside an XML
       comment, the same defect PR #97 fixed once already for the scheduled
       flag on notes-sweep's own plist). The heartbeat interval flag throttles
       the succeeded row to at most one per 1800s (30 min) — recording all
       ~720 fires/day would be pure noise from a healthy channel; a failure is
       still recorded immediately regardless (see ops/config/services.json's
       own note on this service's retuned cadence). The also-heartbeat flag
       rides this same 2-minute wake to record an INDEPENDENT presence signal
       for carr-local-edge-node — the registered fact that this Mac is awake
       and launchd is actually firing agents (PROP-010) — on the same
       throttle, whether or not the buzz query itself succeeds. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/run-scheduled.sh</string>
    <string>--heartbeat-interval</string>
    <string>1800</string>
    <string>--also-heartbeat</string>
    <string>carr-local-edge-node</string>
    <string>partner-ping</string>
    <string>launchd.run</string>
    <string>{{REPO}}/.venv/bin/python</string>
    <string>{{REPO}}/tools/db-tap.py</string>
    <string>run</string>
    <string>pipelines/partner_ping.py</string>
    <!-- The scheduled flag below confines the QUERY (not the wake) to
         weekdays 07:00-19:00 local. Outside that window neither partner is
         reading notification centre, and the query was the last thing keeping
         the Neon compute from ever autosuspending (2026-08-18 cloud-usage
         audit). The flag sits here, after the script path, exactly as
         notes-sweep carries its own. The rule itself lives in
         pipelines/partner_ping.py so the manual and automated paths stay one
         code path. Drop the flag and the job queries around the clock again.

         WRITTEN WITHOUT A DOUBLE HYPHEN ON PURPOSE. XML forbids the two-dash
         sequence inside a comment, so naming the flag literally here made this
         file unparseable by Python's plistlib while plutil and launchd both
         accepted it. That silently disabled the missing-program check in
         ops/config-as-code.py, which returns "no missing paths" for any plist
         it cannot read. ops/config-as-code-selftest.py now refuses the whole
         set on a parse failure, so this cannot come back unnoticed. -->
    <string>--scheduled</string>
  </array>

  <key>WorkingDirectory</key>
  <string>{{REPO}}</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- THE ONE MACHINE-SPECIFIC VALUE. joe on Joe's Mac, dell on Dell's. -->
    <key>CARR_PARTNER</key>
    <string>joe</string>
    <key>PATH</key>
    <string>/usr/local/bin:/usr/bin:/bin:/opt/homebrew/bin</string>
  </dict>

  <!-- carr-launchd-interval-seconds: 120 | rendered by lib/launchd_calendar.py; macOS 27 launchd never fires StartInterval -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>2</integer></dict>
    <dict><key>Minute</key><integer>4</integer></dict>
    <dict><key>Minute</key><integer>6</integer></dict>
    <dict><key>Minute</key><integer>8</integer></dict>
    <dict><key>Minute</key><integer>10</integer></dict>
    <dict><key>Minute</key><integer>12</integer></dict>
    <dict><key>Minute</key><integer>14</integer></dict>
    <dict><key>Minute</key><integer>16</integer></dict>
    <dict><key>Minute</key><integer>18</integer></dict>
    <dict><key>Minute</key><integer>20</integer></dict>
    <dict><key>Minute</key><integer>22</integer></dict>
    <dict><key>Minute</key><integer>24</integer></dict>
    <dict><key>Minute</key><integer>26</integer></dict>
    <dict><key>Minute</key><integer>28</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>32</integer></dict>
    <dict><key>Minute</key><integer>34</integer></dict>
    <dict><key>Minute</key><integer>36</integer></dict>
    <dict><key>Minute</key><integer>38</integer></dict>
    <dict><key>Minute</key><integer>40</integer></dict>
    <dict><key>Minute</key><integer>42</integer></dict>
    <dict><key>Minute</key><integer>44</integer></dict>
    <dict><key>Minute</key><integer>46</integer></dict>
    <dict><key>Minute</key><integer>48</integer></dict>
    <dict><key>Minute</key><integer>50</integer></dict>
    <dict><key>Minute</key><integer>52</integer></dict>
    <dict><key>Minute</key><integer>54</integer></dict>
    <dict><key>Minute</key><integer>56</integer></dict>
    <dict><key>Minute</key><integer>58</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/tmp/carr-partner-ping.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/carr-partner-ping.err</string>
</dict>
</plist>
