<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Umask</key>
	<integer>63</integer>
	<key>Label</key>
	<string>com.carr.dispatch-emergencies-weekly</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>{{REPO}}/bin/run-scheduled.sh</string>
		<string>dispatch-emergencies-weekly</string>
		<string>dispatch.emergencies</string>
		<string>{{REPO}}/.venv/bin/python</string>
		<string>{{REPO}}/tools/room-bridge/dispatch.py</string>
		<string>emergency-report</string>
	</array>
	<key>WorkingDirectory</key>
	<string>{{REPO}}</string>
	<key>StartCalendarInterval</key>
	<dict>
		<key>Weekday</key>
		<integer>1</integer>
		<key>Hour</key>
		<integer>8</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
	<key>RunAtLoad</key>
	<false/>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>{{HOME}}/.local/bin:{{HOME}}/.npm-global/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
		<key>TZ</key>
		<string>America/Chicago</string>
	</dict>
	<key>StandardOutPath</key>
	<string>{{REPO}}/out/dispatch-emergencies-weekly.log</string>
	<key>StandardErrorPath</key>
	<string>{{REPO}}/out/dispatch-emergencies-weekly.error.log</string>
</dict>
</plist>
