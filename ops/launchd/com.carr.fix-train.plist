<?xml version="1.0" encoding="UTF-8"?>
<!-- doctrine: studio-macbook-failover -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.carr.fix-train</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>{{REPO}}/out/orch/fix-train.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{REPO}}/out/orch/fix-train/launchd.out</string>
	<key>StandardOutPath</key>
	<string>{{REPO}}/out/orch/fix-train/launchd.out</string>
	<key>WorkingDirectory</key>
	<string>{{REPO}}/out/orch</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
	</dict>
</dict>
</plist>
