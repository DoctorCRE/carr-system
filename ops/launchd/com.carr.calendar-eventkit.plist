<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.carr.calendar-eventkit — unattended calendar capture, weekday mornings.

  REPLACES the Cowork task calendar-fetch-daily, which Joe paused on 2026-08-14
  because it read a PUBLISHED feed that Microsoft strips of attendee data by
  design: 6 matches out of 81 events. The local read finds attendees on about half
  of all events (386 of 936 on the 2026-08-13 dump) — the half that names who was
  actually in the room.

  A LAUNCH AGENT, NOT A SCHEDULED MODEL SESSION, and that is the council's ruling
  rather than a preference: PROP-010 says deterministic recurring work runs from
  versioned repo code executed by a registered Local Edge Node through launchd or
  another governed scheduler, and "do not spend a model session on deterministic
  work". Matching an email to a record is a predicate, not a judgement.

  IT MUST BE AN AGENT AND NOT A DAEMON. The capture launches the access bundle
  with `open -a`, because macOS attributes calendar permission to the responsible
  process and only the bundle holds the grant. That needs Joe's GUI session, which
  is what a LaunchAgent runs in and a LaunchDaemon does not. The cost is honest and
  worth stating: this does not run while he is logged out, and the window simply
  widens on the next run rather than losing anything.

  RISK: YELLOW. Reads the calendar read-only, writes only internal touch records
  through stamp-touch, sends nothing outside, publishes nothing. Exact email
  matches are logged; domain-only matches and unknown addresses are reported and
  never written.

  Verified by OUTPUT, never by the schedule existing: out/calendar-capture.log
  carries one run block per fire, and a DENIED read exits 3 rather than reporting
  zero touches.

  Program 4 follow-up: PR #97 closed the launchd-seven's recording gap
  (rules-refresh, local-briefs, notes-sweep, capture-poll, partner-ping,
  recordings-purge) and deliberately left this job out —
  it did not yet have a services.json registration. It has one now (see that
  file); routed through bin/run-scheduled.sh here so its own success/failure
  becomes a durable ops.run row instead of living only in
  out/calendar-capture.log. No throttle — weekday daily is already low-volume.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carr.calendar-eventkit</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/run-scheduled.sh</string>
    <string>calendar-eventkit</string>
    <string>launchd.run</string>
    <string>/bin/sh</string>
    <string>{{REPO}}/bin/calendar-eventkit-capture.sh</string>
    <string>--days</string>
    <string>7</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    <key>CARR_REPO</key>
    <string>{{REPO}}</string>
  </dict>

  <!-- Weekdays at 07:20, just after the old feed fetch's slot. A seven-day
       window on a daily run is deliberate overlap: stamp-touch is idempotent on
       its key, so a missed morning is picked up by the next one instead of
       leaving a hole. -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Weekday</key><integer>6</integer><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
  </array>

  <key>StandardOutPath</key>
  <string>{{REPO}}/out/calendar-capture.log</string>
  <key>StandardErrorPath</key>
  <string>{{REPO}}/out/calendar-capture.log</string>

  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
