<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.carr.fleet-sync — keep THIS Mac's checkout, installed gates, and the
  sibling GitHub checkouts (doctorcre-app, software-factory) current.

  Installed on BOTH machines on purpose: it is the one job whose whole reason
  for existing is that the second machine drifts silently. It is therefore
  deliberately absent from PRIMARY_ONLY in ops/config-as-code.py.

  HOURLY, PLUS RunAtLoad (2026-09-23). Joe wants this to "always" be current
  without having to remember it: "if im on my macbook working or my studio or
  whatever, i dont want to have to remember to do that." Four fixed fires a
  day left a machine that had been asleep or unused for a stretch showing
  stale work for up to twelve hours; RunAtLoad plus an hourly calendar fire
  means login or wake catches a Mac up immediately, and nothing is ever more
  than an hour behind while it's on. The job stays cheap and idempotent (a
  no-op re-render when everything is already current), so an hourly cadence
  costs nothing extra it didn't already tolerate at 07:45/11:45/15:45/19:45.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carr.fleet-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/run-scheduled.sh</string>
    <string>fleet-sync</string>
    <string>fleet.sync</string>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/fleet-sync.sh</string>
  </array>

  <!-- carr-launchd-interval-seconds: 3600 | rendered by lib/launchd_calendar.py; macOS 27 launchd never fires StartInterval -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>31</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>{{REPO}}/out/fleet-sync.log</string>
  <key>StandardErrorPath</key>
  <string>{{REPO}}/out/fleet-sync.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
