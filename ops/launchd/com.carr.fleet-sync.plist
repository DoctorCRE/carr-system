<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.carr.fleet-sync — keep THIS Mac's checkout, installed gates, and the
  sibling GitHub checkouts (doctorcre-app, software-factory) current.

  Installed on BOTH machines on purpose: it is the one job whose whole reason
  for existing is that the second machine drifts silently. It is therefore
  deliberately absent from PRIMARY_ONLY in ops/config-as-code.py.

  EVERY FIVE MINUTES, PLUS RunAtLoad. An hourly sync leaves releases blocked
  on controller_stale after merges. Keep the existing fast-forward safeguards
  and installer path; the release pipeline still waits for a fresh tick to
  load the synced controller. RunAtLoad also catches the checkout up at login.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carr.fleet-sync</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/run-scheduled.sh</string>
    <string>fleet-sync</string>
    <string>fleet.sync</string>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/fleet-sync.sh</string>
  </array>

  <!-- carr-launchd-interval-seconds: 300 | rendered by lib/launchd_calendar.py; macOS 27 launchd never fires StartInterval -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>5</integer></dict>
    <dict><key>Minute</key><integer>10</integer></dict>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>20</integer></dict>
    <dict><key>Minute</key><integer>25</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>35</integer></dict>
    <dict><key>Minute</key><integer>40</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
    <dict><key>Minute</key><integer>50</integer></dict>
    <dict><key>Minute</key><integer>55</integer></dict>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>{{REPO}}/out/fleet-sync.log</string>
  <key>StandardErrorPath</key>
  <string>{{REPO}}/out/fleet-sync.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
</dict>
</plist>
