<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        WO-4 capture bridge, claim side. Same WatchPaths pattern as
        com.carr.dictation-consent: fires on directory-entry changes inside
        ~/Recordings (a new session starting, or meta.json/announcement.json
        appearing at stop). capture-watch.sh is itself idempotent per
        session (skips dirs that already carry .capture.json or
        ingested.json) and waits out the consent-before-claim window
        internally, so repeat WatchPaths firings are harmless.

        This plist references the DURABLE main-checkout path, not the
        wo4-capture-bridge build worktree — see the identical note in
        com.carr.dictation-consent.plist.
    -->
    <key>Label</key>
    <string>com.carr.capture-watch</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>{{REPO}}/bin/run-scheduled.sh</string>
        <string>capture-watch</string>
        <string>launchd.run</string>
        <string>{{REPO}}/tools/dictation-rig/bin/capture-watch.sh</string>
      </array>

    <key>WatchPaths</key>
    <array>
        <string>{{HOME}}/Recordings</string>
    </array>

    <!--
        Coalesce rapid-fire filesystem events (mic.caf/system.caf growing
        during recording, meta.json + announcement.json appearing at stop)
        into at most one run per second — same rationale as
        com.carr.dictation-consent's ThrottleInterval.
    -->
    <key>ThrottleInterval</key>
    <integer>1</integer>

    <key>StandardOutPath</key>
    <string>{{HOME}}/Library/Logs/capture-bridge.log</string>

    <key>StandardErrorPath</key>
    <string>{{HOME}}/Library/Logs/capture-bridge.log</string>

    <key>RunAtLoad</key>
    <false/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
