<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- doctrine: repo-hygiene-program-build-plan -->
  <!-- WR-000040 AC-FRESH, second of two agents, and the one that must survive
       the other. It reaches its verdict from the repository alone: it never
       calls the fast-forward and never reads anything the fast-forward wrote,
       so it still pages when that agent is unloaded, its program is missing, or
       the machine slept through every one of its windows — the failure launchd
       reports to nobody.

       Cadence: hourly, per Joe's AC-FRESH ruling (decision
       fa8ae14b-e6fe-4e1b-ae98-0b6eb5a255f8, 2026-09-11), narrowed there to page
       on TRACKED dirt only. Untracked paths are counted and named in every
       report and never alarm: AC-CLEAN routes those to Joe for a per-path
       ruling, and a watchdog that paged daily about paths awaiting a human
       decision would train its reader to ignore it.

       It pages by two independent routes so one channel failing is not silence:
       a durable report-problem record through {{REPO}}/run.sh, and a nonzero
       exit that bin/run-scheduled.sh turns into a failed run row. Route one
       failing never suppresses route two. -->
  <key>Label</key><string>com.carr.canonical-dirty-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>{{REPO}}/bin/run-scheduled.sh</string>
    <string>canonical-dirty-watchdog</string>
    <string>launchd.run</string>
    <string>{{REPO}}/.venv/bin/python</string>
    <string>{{REPO}}/tools/repo-hygiene-janitor.py</string>
    <string>--canonical-freshness</string>
    <string>watchdog</string>
    <string>--repository</string>
    <string>{{REPO}}</string>
    <!-- The AC-FRESH bar itself, stated here rather than left to a default, so
         a reader of the schedule can see the number the alarm is holding to.
         It is exclusive: a HEAD exactly at 24h is AT the bar, not past it, so a
         daily job that lands a minute late does not page. -->
    <string>--max-age-hours</string>
    <string>24</string>
  </array>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <!-- carr-launchd-interval-seconds: 3600 | rendered by lib/launchd_calendar.py; macOS 27 launchd never fires StartInterval -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>7</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>StandardOutPath</key><string>{{REPO}}/out/canonical-dirty-watchdog.log</string>
  <key>StandardErrorPath</key><string>{{REPO}}/out/canonical-dirty-watchdog.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/local/opt/node@22/bin:/opt/homebrew/opt/libpq/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
