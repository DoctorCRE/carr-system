<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Keep THIS Mac's checkout on main. Every five minutes and at load, git
         fast-forwards the checkout and nothing else: no script, no wrapper, no
         config reinstall. git refuses a dirty or diverged tree on its own and
         exits nonzero; job-watchdog and scheduled-jobs-check report that exit.
         Replaces bin/fleet-sync.sh, deleted in #2150, after which the Studio
         checkout sat 11 hours behind main (2026-10-25/26). -->
    <key>Label</key>
    <string>com.carr.checkout-pull</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/git</string>
        <string>-C</string>
        <string>{{REPO}}</string>
        <string>pull</string>
        <string>--ff-only</string>
        <string>--quiet</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <!-- carr-launchd-interval-seconds: 300 | rendered by lib/launchd_calendar.py; macOS 27 launchd never fires StartInterval -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Minute</key><integer>0</integer></dict>
        <dict><key>Minute</key><integer>5</integer></dict>
        <dict><key>Minute</key><integer>10</integer></dict>
        <dict><key>Minute</key><integer>15</integer></dict>
        <dict><key>Minute</key><integer>20</integer></dict>
        <dict><key>Minute</key><integer>25</integer></dict>
        <dict><key>Minute</key><integer>30</integer></dict>
        <dict><key>Minute</key><integer>35</integer></dict>
        <dict><key>Minute</key><integer>40</integer></dict>
        <dict><key>Minute</key><integer>45</integer></dict>
        <dict><key>Minute</key><integer>50</integer></dict>
        <dict><key>Minute</key><integer>55</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>{{REPO}}/out/checkout-pull.log</string>
    <key>StandardErrorPath</key>
    <string>{{REPO}}/out/checkout-pull.log</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>GIT_TERMINAL_PROMPT</key><string>0</string>
    </dict>
</dict>
</plist>
