<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  com.carr.checkout-pull: keep this Mac's checkouts on the latest main, so the
  product jobs that run from them (Outlook intake, nightly, call notes) run
  merged code. Replaces bin/fleet-sync.sh. A plain fast-forward only: it never
  discards local work, and a checkout that cannot fast-forward is left as is.
  Install: copy to ~/Library/LaunchAgents with {{HOME}} replaced, then
  launchctl bootstrap gui/$UID ~/Library/LaunchAgents/com.carr.checkout-pull.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carr.checkout-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>for repo in {{HOME}}/carr-system {{HOME}}/doctorcre-app; do /usr/bin/git -C "$repo" pull --ff-only --quiet || echo "checkout-pull: $repo did not fast-forward"; done</string>
  </array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>15</integer></dict>
    <dict><key>Minute</key><integer>30</integer></dict>
    <dict><key>Minute</key><integer>45</integer></dict>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/carr-checkout-pull.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/carr-checkout-pull.log</string>
</dict>
</plist>
