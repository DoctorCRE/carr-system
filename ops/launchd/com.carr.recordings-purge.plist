<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Recordings retention law (decision db7b0231): raw audio purges 72h
         after transcription; transcript + consent proof survive. Daily at
         04:15 local; RunAtLoad catches the case where the Mac was asleep. -->
    <key>Label</key>
    <string>com.carr.recordings-purge</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>{{REPO}}/bin/run-scheduled.sh</string>
        <string>recordings-purge</string>
        <string>launchd.run</string>
        <string>/bin/sh</string>
        <string>{{REPO}}/tools/dictation-rig/bin/purge-recordings.sh</string>
      </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>15</integer>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
    </dict>
</dict>
</plist>
