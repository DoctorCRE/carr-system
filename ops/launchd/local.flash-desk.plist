<?xml version="1.0" encoding="UTF-8"?>
<!-- doctrine: studio-macbook-failover -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>AbandonProcessGroup</key>
	<true/>
	<key>Label</key>
	<string>local.flash-desk</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{HOME}}/.local/bin/flash-desk-start</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>{{HOME}}/Library/Logs/flash-desk.log</string>
	<key>StandardOutPath</key>
	<string>{{HOME}}/Library/Logs/flash-desk.log</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
	</dict>
</dict>
</plist>
