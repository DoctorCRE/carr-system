#!/bin/sh
# Check pushed content locally; GitHub rulesets protect main and its history.

REFS="$(cat)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
COMMON_DIR="$(git rev-parse --path-format=absolute --git-common-dir)"
PY="$COMMON_DIR/../.venv/bin/python"
[ -x "$PY" ] || PY=python3
# The leak guard excludes only what this push's receiver (its URL, $2) advertises.
CARR_PUSH_RECEIVER="${2:-${1:-origin}}"
export CARR_PUSH_RECEIVER
printf '%s\n' "$REFS" | "$PY" "$REPO_ROOT/security/leak_guard.py" \
  --root "$REPO_ROOT" --pre-push --remote "$CARR_PUSH_RECEIVER" || exit 1

# The scoped floor catches content failures before upload. Hosted CI runs the full suite.
_SKIP_REASON_TRIMMED="$(printf '%s' "$CARR_SKIP_CI_REASON" | tr -d '[:space:]')"
_EFFECTIVE_SKIP_CI="$CARR_SKIP_CI"
if [ "$CARR_SKIP_CI" = "1" ] 2>/dev/null && [ -z "$_SKIP_REASON_TRIMMED" ]; then
  echo "  pre-push: CARR_SKIP_CI=1 requires a non-empty, non-whitespace CARR_SKIP_CI_REASON — ignoring the skip and running quality checks" >&2
  _EFFECTIVE_SKIP_CI=""
fi

if [ -n "$REPO_ROOT" ] && [ -x "$REPO_ROOT/ops/ci.sh" ]; then
  if [ "$_EFFECTIVE_SKIP_CI" = "1" ] 2>/dev/null; then
    mkdir -p "$REPO_ROOT/out" 2>/dev/null
    _SKIP_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo detached)"
    _SKIP_HEAD="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
    _SKIP_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if ! "$PY" - "$_SKIP_TS" "$_SKIP_BRANCH" "$_SKIP_HEAD" "$CARR_SKIP_CI_REASON" \
      >> "$REPO_ROOT/out/ci-skip-receipts.jsonl" 2>/dev/null <<'PYEOF'
import json, sys
ts, branch, head, reason = sys.argv[1:5]
print(json.dumps({"ts": ts, "branch": branch, "head": head, "reason": reason}))
PYEOF
    then
      echo "  pre-push: could not write the skip receipt to out/ci-skip-receipts.jsonl — refusing the skip and running quality checks instead (fail closed, bypass audit item 10)" >&2
      _EFFECTIVE_SKIP_CI=""
    fi
  fi

  if [ "$_EFFECTIVE_SKIP_CI" = "1" ] 2>/dev/null; then
    echo "  pre-push: CARR_SKIP_CI=1 — quality checks skipped for this command (reason: $CARR_SKIP_CI_REASON)" >&2
  else
    # THE PUSHED RANGE, which is what makes the secret scan cost O(this push)
    # instead of O(repository): 1,514 files were read on every push before this.
    # Deliberately conservative -- anything it cannot work out exactly leaves
    # CARR_CI_RANGE unset, and an unset range means the FULL scan, so the
    # failure direction is "slower", never "unchecked".
    ZERO="0000000000000000000000000000000000000000"
    CARR_CI_RANGE=""
    RANGE_COUNT=0
    while read -r l_ref l_sha r_ref r_sha; do
      [ -n "$l_ref" ] || continue
      [ "$l_sha" = "$ZERO" ] && continue        # a deletion ships no content
      RANGE_COUNT=$((RANGE_COUNT+1))
      if [ -n "$r_sha" ] && [ "$r_sha" != "$ZERO" ]; then
        CARR_CI_RANGE="$r_sha..$l_sha"
      elif git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
        # A NEW BRANCH, and the base must be the MERGE BASE, not origin/main
        # itself. `git diff origin/main..HEAD` is a two-dot diff: it reports the
        # difference between two trees, so every commit main gained while this
        # branch was in flight shows up as a change this push is making — in
        # reverse. Measured on this branch: seventeen paths, of which five were
        # other sessions' work on main (a gate, two mcp-server files, a selftest,
        # the gate baseline). The floor would then typecheck files this push does
        # not touch and run another session's selftest as though it were ours.
        # Pinning the base to the merge base makes two-dot mean what three-dot
        # means, and keeps every consumer of CARR_CI_RANGE simple.
        _base="$(git merge-base origin/main "$l_sha" 2>/dev/null)"
        if [ -n "$_base" ]; then
          CARR_CI_RANGE="$_base..$l_sha"
        else
          CARR_CI_RANGE=""
        fi
      else
        CARR_CI_RANGE=""
      fi
    done <<EOF
$REFS
EOF
    # More than one ref in one push: the ranges do not compose into a single
    # expression, so take the whole-tree scan rather than silently checking one
    # branch and calling it all of them.
    [ "$RANGE_COUNT" -gt 1 ] && CARR_CI_RANGE=""
    export CARR_CI_RANGE

    # WHICH CLASSES THE FLOOR RUNS, decided from the diff (ci-failures council,
    # 2026-08-24). pushfloor carries the diff-scoped predictors; the classes named
    # here are whole classes cheap enough to keep local.
    #
    #   secret     — NOT a red-predictor, and kept anyway. The council's table
    #                drops it because it has never failed hosted, which is a
    #                frequency argument; this control exists so a credential does
    #                not reach the remote, and "it has not happened yet" is the
    #                weakest possible reason to remove that. The gates council
    #                before it ruled the opposite way and in as many words —
    #                keep secrets local no matter what. Range-
    #                scoped it costs about a second. Kept.
    #   migration  — ONLY when the diff touches migrations/. The class is 33s
    #                hosted and needs a throwaway Postgres, so it SKIPs on a
    #                laptop; adding it unconditionally would buy a skip line.
    #
    # SPACE-SEPARATED, NOT COMMA-SEPARATED, and the separator is the whole bug.
    #
    # ci.sh accepts either — its usage line says "comma- or space-separated" —
    # but it has only accepted COMMAS since the push-floor change that taught
    # `--only` to split them. Before that, `--only` was a plain assignment, so a
    # comma list arrived as ONE token and ci.sh refused it with
    # "no such class: pushfloor,secret,freshness,migration".
    #
    # That skew is not hypothetical and it is not self-healing. THIS HOOK IS
    # ALWAYS CANONICAL'S, because core.hooksPath is one shared path for every
    # worktree on the machine, while ci.sh is resolved from REPO_ROOT — the tree
    # actually being pushed. So a worktree branched from a commit older than that
    # change runs TODAY'S hook against THAT DAY'S ci.sh, and every push from it is
    # refused for a class name that does not exist. Observed 2026-08-26: the
    # refusal reads as a quality failure and tells the caller to iterate on the
    # failing class with `ops/ci.sh --only`, which cannot work, because the class
    # it names is the joined string. The natural next move is CARR_SKIP_CI=1
    # without running anything, which is how a broken hook becomes a habit of
    # skipping the floor.
    #
    # Spaces work on BOTH versions: the old assignment leaves the string intact
    # and ci.sh's `for _want in $ONLY` splits it on whitespace; the new one runs
    # tr over a string with no commas and changes nothing. Verified against both
    # parsers before this was written. Do not "tidy" these back into commas.
    FLOOR_CLASSES="pushfloor secret"
    if [ -n "$CARR_CI_RANGE" ] \
        && git diff --name-only "$CARR_CI_RANGE" 2>/dev/null | grep -q '^migrations/'; then
      FLOOR_CLASSES="$FLOOR_CLASSES migration"
    fi

    if [ -n "$CARR_CI_RANGE" ]; then
      echo "  pre-push: checking $CARR_CI_RANGE — $FLOOR_CLASSES (full strict suite runs hosted)…" >&2
    else
      echo "  pre-push: running $FLOOR_CLASSES (full strict suite runs hosted)…" >&2
    fi
    # STRIP THE HOOK'S GIT ENVIRONMENT BEFORE RUNNING CI, and this is not hygiene —
    # it is the fix for a bug that destroyed local main on 2026-08-14.
    #
    # Git exports GIT_DIR (and usually GIT_INDEX_FILE) to every hook. Those
    # variables OVERRIDE cwd for any child `git` process. CI runs selftests that
    # build throwaway repositories with tempfile.mkdtemp and then call git with
    # cwd set to that temp path — which is correct, sandboxed code, and which git
    # ignored entirely here, because GIT_DIR pointed at the live repository.
    #
    # So every one of those fixture commits landed on the LIVE checkout, on
    # whatever branch happened to be current. The damage, found by a peer session:
    # local main sitting on a commit whose tree held THREE files, six commits ahead
    # of origin, five of them selftest artifacts named "seed", "seed unrelated" and
    # one stamped with the fixture hash +deadbeef, with all 818 paths staged as
    # additions — so any commit from any session would have swept the whole repo
    # under one message. Origin was never touched; recovery was a mixed reset.
    #
    # ONE AMENDMENT from the loop #371 pass. Scrubbing here is the right FIRST
    # line of defence and it stays. But "the selftests were never wrong" does not
    # survive contact: a test that mutates whatever repository invoked it is
    # wrong on its own terms, whoever set the variable. This hook is only ONE way
    # ci.sh is reached — another git hook, a merge driver, `git rebase -x`, or a
    # session that simply has GIT_DIR exported all get to the same selftests
    # without passing through here. So the selftests scrub for themselves now
    # (ops/git_env.py) and this remains the outer layer.
    #
    # THE LIST STAYS LITERAL HERE ON PURPOSE. Sourcing it from
    # `python3 ops/git_env.py --unset-args` was tried and reverted: it defeats
    # ops/hook-env-isolation-selftest.py, which deliberately checks that the
    # stripping and the ci.sh call are ONE statically readable statement, and it
    # puts a python dependency on the push path whose fallback would go stale in
    # silence. A literal list that a test can read beats a clever one it cannot.
    # ops/git-env-selftest.py fails if this list stops covering
    # git_env.GIT_LOCATION_VARS, so the two cannot drift even though the words
    # appear twice.
    # The run is TEE'd so the session still watches it live while the text is
    # also kept for the attribution pass below. A pipeline reports the exit
    # status of its LAST command -- tee's, which is always 0 -- so ci.sh's own
    # status is carried out through a file. Getting this wrong would turn every
    # red push green, which is the one bug this hook must not have.
    # NOT `mktemp -t <prefix>`. That is BSD spelling: macOS appends a random
    # suffix to a bare prefix, GNU coreutils REQUIRES the template to contain
    # XXXXXX and errors out without it. This hook runs on Joe's Mac and its
    # selftest runs on an ubuntu runner, so the BSD-only form worked locally and
    # failed hosted -- CI_LOG came back empty, `cat ""` returned 1, and the hook
    # refused every push including the green ones. An explicit template with
    # XXXXXX is the one spelling both implementations read the same way.
    CI_LOG="$(mktemp "${TMPDIR:-/tmp}/carr-prepush-log.XXXXXX")"
    CI_RC_FILE="$(mktemp "${TMPDIR:-/tmp}/carr-prepush-rc.XXXXXX")"
    {
      env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
          -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
          -u GIT_COMMON_DIR -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES \
          -u GIT_WORK_TREE_OVERRIDE -u GIT_CONFIG -u GIT_CONFIG_GLOBAL \
          -u GIT_CONFIG_SYSTEM -u GIT_CONFIG_COUNT \
          sh -c 'exec "$0" --only "$1"' "$REPO_ROOT/ops/ci.sh" "$FLOOR_CLASSES"
      echo $? > "$CI_RC_FILE"
    } 2>&1 | tee "$CI_LOG" >&2
    CI_RC="$(cat "$CI_RC_FILE" 2>/dev/null || echo 1)"
    rm -f "$CI_RC_FILE"
    if [ "$CI_RC" -ne 0 ]; then
      cat >&2 <<'EOF'

  ────────────────────────────────────────────────────────────────
  PUSH REFUSED — carr-system quality checks failed
  ────────────────────────────────────────────────────────────────
  The failing class is named above. Run it on its own to iterate:

      ops/ci.sh --only <class>
      ops/ci.sh --list

  This is the LOCAL FLOOR — the classes the diff implicates, scoped to
  what this push changes. The full strict suite runs hosted and is the
  gate on the merge. The floor exists because the classes that actually
  go red (types, gates) are the ones cheapest to catch right here.

  Each failing check above names its own remedy.

  Fix it. A skip is not printed here on purpose (bypass audit item 10,
  2026-09-24): CARR_SKIP_CI=1 still exists, but only with a non-empty
  CARR_SKIP_CI_REASON, and it now leaves a receipt in
  out/ci-skip-receipts.jsonl -- it is not the obvious next line to paste.

EOF
      # WHOSE FILE IS IT? A refusal that names a path and stops there is one a
      # session on this machine cannot act on: thirty-five worktrees share one
      # canonical checkout, and on 2026-08-09 the cost of guessing wrong was
      # another session's work deleted. So any path this failure named that
      # belongs to somebody ELSE is attributed here by name.
      #
      # A REPORTER, NOT A GATE. It runs only on a failure that already happened,
      # it cannot change the outcome, and if it breaks the refusal above still
      # stands on its own -- which is why its output is best-effort and its own
      # exit status is discarded.
      if [ -x "$REPO_ROOT/ops/worktree-attribution.py" ] \
          && command -v "$PY" >/dev/null 2>&1; then
        MINE="$(basename "$REPO_ROOT")"
        FOREIGN="$(grep -oE '[A-Za-z0-9_./-]+\.[A-Za-z0-9]+' "$CI_LOG" 2>/dev/null \
                   | sort -u | head -40 \
                   | xargs -r "$PY" "$REPO_ROOT/ops/worktree-attribution.py" \
                     --porcelain 2>/dev/null \
                   | awk -F'\t' -v me="$MINE" '$2 != "unknown" && $3 != me && $3 != "-"')"
        if [ -n "$FOREIGN" ]; then
          echo "  Some of those paths are not this worktree's:" >&2
          printf '%s\n' "$FOREIGN" \
            | awk -F'\t' '{printf "      %s\n          belongs to session %s (%s)\n", $1, $3, $4}' >&2
          echo >&2
          echo "  Do not delete or revert those — ask that session, or read its branch." >&2
          echo >&2
        fi
      fi
      echo "  ────────────────────────────────────────────────────────────────" >&2
      echo >&2
      rm -f "$CI_LOG"
      exit 1
    fi
    rm -f "$CI_LOG"
  fi
fi

# The two REPORTERS below run on every push that got this far. Neither can
# change the outcome, so no exit sits above them: until 2026-09-30 a bare
# `exit 0` here left the client-name note unreachable from the day it landed.
# ops/pr-size-check-selftest.py fails if a top-level exit returns above them.

# ---------------------------------------------------------------------------
# CLIENT-NAME NOTE, a REPORTER and not a gate (decision 4d6ce1c7, 2026-09-24).
# Joe: no bulk scrub and no history rewrite; new lines should ideally carry no
# client name, and old ones convert gradually as they are touched. This prints
# file:line for any line the branch ADDS against main that carries a name from
# the gitignored local list, never the name itself, and a one-line reminder to
# swap in a pseudonym. It never changes the push's outcome: its exit status is
# discarded, it is silent when the local list is absent, and it has no CI step.
# ---------------------------------------------------------------------------
if [ -n "$REPO_ROOT" ] && [ -f "$REPO_ROOT/ops/githooks/client-name-warn.py" ] \
    && command -v "$PY" >/dev/null 2>&1; then
  "$PY" "$REPO_ROOT/ops/githooks/client-name-warn.py" "origin/main...HEAD" "$REPO_ROOT" || true
fi

# ---------------------------------------------------------------------------
# DECOMPOSITION NOTE, a REPORTER and not a gate (engineering-workflow-sop
# section 15, small incremental changes). Over 300 changed lines or 5 files
# outside generated paths, or moves mixed with edits, prints a short split
# suggestion. Silent otherwise; exit status discarded; Git's hook variables
# stripped so its git calls read this checkout and nothing else.
# ---------------------------------------------------------------------------
if [ -n "$REPO_ROOT" ] && [ -f "$REPO_ROOT/ops/pr-size-check.py" ] \
    && command -v "$PY" >/dev/null 2>&1; then
  env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
      -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
      -u GIT_COMMON_DIR -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES \
      "$PY" "$REPO_ROOT/ops/pr-size-check.py" "origin/main...HEAD" "$REPO_ROOT" || true
fi
exit 0
