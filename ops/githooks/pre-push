#!/bin/sh
# pre-push — refuse a direct push to main from anyone but the repo owner.
#
# WHY THIS EXISTS. On 2026-08-03 Dell was granted WRITE on carr-system,
# superseding the read-plus-fork-PR model in team-loops T39 where every change
# of his went through a pull request Joe approved. That review WAS the guard.
# GitHub branch protection would replace it, but this repo is private on a free
# plan and the API refuses: "Upgrade to GitHub Pro or make this repository
# public to enable this feature." So there is no server-side gate at all.
#
# The realistic failure is not malice, it is history. This repo's history was
# REWRITTEN on 2026-08-01 for the PII purge, which is why Dell re-clones from
# scratch rather than pulling. A session on a second machine that does not know
# that can force-push over the purge while doing something entirely reasonable.
#
# WHAT THIS IS AND IS NOT. It is an accident-stopper, not a security control.
# It is a local hook: anyone can bypass it by editing this file, unsetting
# core.hooksPath, or passing --no-verify. That is fine and expected — it exists
# to catch the push nobody meant to make, which is the only kind that has ever
# happened here. If real enforcement is wanted, GitHub Pro at roughly 4 USD a
# month enables branch protection and this file becomes redundant.
#
# HOW IT DECIDES, with no per-machine configuration to forget: the repo owner is
# identified by git identity. Joe's is set globally on his Mac and matches
# OWNER_EMAIL below. Any other identity pushing to main is stopped and told to
# branch instead. An explicit override exists for the case where the owner is on
# a machine whose identity is not yet configured.

OWNER_EMAIL="64207374+jbookout@users.noreply.github.com"
PROTECTED="refs/heads/main"

REFS="$(cat)"
REPO_ROOT="$(git rev-parse --show-toplevel)"
printf '%s\n' "$REFS" | python3 "$REPO_ROOT/security/leak_guard.py" \
  --root "$REPO_ROOT" --pre-push --remote "${1:-origin}" || exit 1

# Deliberate escape hatch. Set it for one command, never export it in a profile:
#   CARR_ALLOW_MAIN_PUSH=1 git push
if [ "$CARR_ALLOW_MAIN_PUSH" = "1" ]; then
  exit 0
fi

# STDIN IS READ ONCE, HERE. Git streams the pushed refs on stdin and a hook gets
# exactly one pass over them; the owner check below used to consume the stream,
# which was fine when nothing after it needed the refs. The quality gate now
# derives the pushed COMMIT RANGE from them, so both readers replay this
# variable instead of the pipe.

printf '%s\n' "$REFS" | while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "$PROTECTED" ] || continue

  ME="$(git config user.email 2>/dev/null)"
  [ "$ME" = "$OWNER_EMAIL" ] && continue

  # A deletion or a non-fast-forward is the shape that destroys history.
  EXTRA=""
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    EXTRA="  This push DELETES the branch."
  elif [ -n "$remote_sha" ] && [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      EXTRA="  This push REWRITES history that is already on the remote — the shape that would undo the 2026-08-01 PII purge."
    fi
  fi

  cat >&2 <<EOF

  ────────────────────────────────────────────────────────────────
  PUSH TO main REFUSED — carr-system pre-push hook
  ────────────────────────────────────────────────────────────────
  Pushing as: ${ME:-(no git identity set)}
  Only the repo owner pushes straight to main.${EXTRA}

  Do this instead:

      git switch -c your-branch-name
      git push -u origin your-branch-name

  Then open a pull request. Joe reviews and merges. Nothing of yours
  is blocked by his side and nothing of his is overwritten by yours.

  If you are Joe and this machine has no git identity yet:

      git config --global user.email "$OWNER_EMAIL"

  Genuine one-off override, for this single command only:

      CARR_ALLOW_MAIN_PUSH=1 git push

  ────────────────────────────────────────────────────────────────

EOF
  exit 1
done || exit 1

# ---------------------------------------------------------------------------
# PROGRAM 2 QUALITY GATE, added 2026-08-13.
#
# WHY IT IS HERE AND NOT ONLY IN CI. GitHub Actions runs the same checks on every
# push, but this repo is private on a free plan, so a red CI run cannot BLOCK
# anything — branch protection and rulesets both refuse with "Upgrade to GitHub
# Pro" (verified live against both endpoints). Until Pro is enabled, this hook is
# the only place a failing check actually stops something, so a red tree does not
# leave the machine.
#
# WHAT IT RUNS NOW, AND WHY IT IS LESS THAN IT WAS (2026-08-23 gates council).
# The paragraph above was written on 2026-08-13, when it was true that "a red CI
# run cannot BLOCK anything" because the repo was private on a free plan. GitHub
# Pro was enabled 2026-08-14 and `ops/ci.sh --strict` is now the REQUIRED status
# check on main: nothing merges red, server-side, whatever this file does. The
# full ten-class local run stopped being the merge envelope that day and became
# defence-in-depth paid for in the scarcest resource this shop has -- wall-clock
# on one contended Mac, times the eleven implementation sessions pushing from it.
#
# The council's second chair was explicit that this is a COST TRADE and not a
# defect finding: the old design was right for its date. What it costs is minutes
# per push, dominated by the gates class, and what it buys, post-Pro, is catching
# hosted-CI failures slightly earlier. (This line used to quote a fixed second
# count for that class. It was measured once and never again, drifted badly, and
# was still being cited as justification -- so the number is gone rather than
# refreshed. ops/ci.sh prints the real one on every run.)
#
# So the split is now:
#   * HOSTED keeps the full strict ten-class suite, unchanged, as the gate on
#     the merge. Nothing was deleted and nothing stopped being checked.
#   * LOCAL keeps the floor -- the classes that are cheap AND whose failure is
#     dramatically more expensive to discover later. See check_pushfloor() in
#     ops/ci.sh for why each member is in it.
#
# THE FLOOR IS A SMOKE PATH, TARGETING ABOUT A MINUTE (F4, 2026-09-08). Every
# check on it is scoped to the pushed diff, so what a push pays for is the
# selftests of the gates it actually touched. That is a target, not a guarantee:
# a push that touches several gates pays for several suites, and a slow paired
# selftest is still slow.
#
# What was removed is the one UNBOUNDED item -- check_pushfloor() used to fall
# back to running the entire gates class whenever the push touched a gate with
# no paired selftest. The gate is still detected and named; the class runs
# hosted, where it is the required check that blocks the merge.
#
# Nothing is skipped and no timeout is involved. ops/ci.sh prints the floor's
# own wall-clock on every run, so the cost stays visible rather than remembered
# -- which is how the stale price above went unnoticed in the first place.
#
# WHY A BOUND IS WORTH MORE THAN THE EXTRA COVERAGE. The realistic failure of
# this hook is not that it misses something; it is that a session facing a
# six-minute wait reaches for --no-verify, which disables the WHOLE file --
# owner check, secret scan and all. A floor that always returns quickly is a
# floor that keeps running.
#
# IT STILL CALLS ops/ci.sh AND DEFINES NO CHECKS OF ITS OWN (rule a8c55a47).
# That is why the subset is expressed as `--only <classes>` rather than as a
# list of scripts here: a hand-rolled fast suite in this file would be a second
# implementation, and it would drift from the one CI runs the first time someone
# added a check to only one of them. The hook chooses classes; it does not
# define checks.
#
# NOT --strict, deliberately. On a laptop there is no throwaway Postgres, so the
# migration class SKIPs, and under --strict a skip is a failure. Failing every
# local push over a database that is only ever present in CI would teach everyone
# to pass --no-verify, which would disable the whole hook rather than one class.
# CI runs --strict; here a skip is reported and allowed.
#
# THE ESCAPE HATCH IS REAL AND STATED. --no-verify skips this, same as it skips
# the branch guard above. This is an accident-stopper, not a security control:
# anyone can edit this file or unset core.hooksPath. It exists to catch the push
# nobody meant to make, which is the only kind that has ever happened here.
# ---------------------------------------------------------------------------

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"

# bypass audit item 10 (2026-09-24), REDESIGNED 2026-09-24 (Opus review):
# CARR_SKIP_CI=1 alone used to skip the floor silently, with no receipt
# anywhere it was used and printed by the refusal text below as the obvious
# next move on any failure. A bare skip flag with no stated reason and no
# trail is exactly the "quiet door" the audit named. A skip now needs a
# non-empty, non-whitespace-only CARR_SKIP_CI_REASON, AND a receipt that
# actually lands on disk — a reason of "   " is not a reason, and a skip
# whose receipt could not be written is not honoured at all: no receipt, no
# skip, the checks run instead. Fail CLOSED on the receipt write, same
# direction as everything else in this file that would rather run the checks
# than silently let one through.
_SKIP_REASON_TRIMMED="$(printf '%s' "$CARR_SKIP_CI_REASON" | tr -d '[:space:]')"
_EFFECTIVE_SKIP_CI="$CARR_SKIP_CI"
if [ "$CARR_SKIP_CI" = "1" ] 2>/dev/null && [ -z "$_SKIP_REASON_TRIMMED" ]; then
  echo "  pre-push: CARR_SKIP_CI=1 requires a non-empty, non-whitespace CARR_SKIP_CI_REASON — ignoring the skip and running quality checks" >&2
  _EFFECTIVE_SKIP_CI=""
fi

if [ -n "$REPO_ROOT" ] && [ -x "$REPO_ROOT/ops/ci.sh" ]; then
  if [ "$_EFFECTIVE_SKIP_CI" = "1" ] 2>/dev/null; then
    mkdir -p "$REPO_ROOT/out" 2>/dev/null
    _SKIP_BRANCH="$(git symbolic-ref --short HEAD 2>/dev/null || echo detached)"
    _SKIP_HEAD="$(git rev-parse HEAD 2>/dev/null || echo unknown)"
    _SKIP_TS="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    if ! python3 - "$_SKIP_TS" "$_SKIP_BRANCH" "$_SKIP_HEAD" "$CARR_SKIP_CI_REASON" \
      >> "$REPO_ROOT/out/ci-skip-receipts.jsonl" 2>/dev/null <<'PYEOF'
import json, sys
ts, branch, head, reason = sys.argv[1:5]
print(json.dumps({"ts": ts, "branch": branch, "head": head, "reason": reason}))
PYEOF
    then
      echo "  pre-push: could not write the skip receipt to out/ci-skip-receipts.jsonl — refusing the skip and running quality checks instead (fail closed, bypass audit item 10)" >&2
      _EFFECTIVE_SKIP_CI=""
    fi
  fi

  if [ "$_EFFECTIVE_SKIP_CI" = "1" ] 2>/dev/null; then
    echo "  pre-push: CARR_SKIP_CI=1 — quality checks skipped for this command (reason: $CARR_SKIP_CI_REASON)" >&2
  else
    # THE PUSHED RANGE, which is what makes the secret scan cost O(this push)
    # instead of O(repository): 1,514 files were read on every push before this.
    # Deliberately conservative -- anything it cannot work out exactly leaves
    # CARR_CI_RANGE unset, and an unset range means the FULL scan, so the
    # failure direction is "slower", never "unchecked".
    ZERO="0000000000000000000000000000000000000000"
    CARR_CI_RANGE=""
    RANGE_COUNT=0
    while read -r l_ref l_sha r_ref r_sha; do
      [ -n "$l_ref" ] || continue
      [ "$l_sha" = "$ZERO" ] && continue        # a deletion ships no content
      RANGE_COUNT=$((RANGE_COUNT+1))
      if [ -n "$r_sha" ] && [ "$r_sha" != "$ZERO" ]; then
        CARR_CI_RANGE="$r_sha..$l_sha"
      elif git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
        # A NEW BRANCH, and the base must be the MERGE BASE, not origin/main
        # itself. `git diff origin/main..HEAD` is a two-dot diff: it reports the
        # difference between two trees, so every commit main gained while this
        # branch was in flight shows up as a change this push is making — in
        # reverse. Measured on this branch: seventeen paths, of which five were
        # other sessions' work on main (a gate, two mcp-server files, a selftest,
        # the gate baseline). The floor would then typecheck files this push does
        # not touch and run another session's selftest as though it were ours.
        # Pinning the base to the merge base makes two-dot mean what three-dot
        # means, and keeps every consumer of CARR_CI_RANGE simple.
        _base="$(git merge-base origin/main "$l_sha" 2>/dev/null)"
        if [ -n "$_base" ]; then
          CARR_CI_RANGE="$_base..$l_sha"
        else
          CARR_CI_RANGE=""
        fi
      else
        CARR_CI_RANGE=""
      fi
    done <<EOF
$REFS
EOF
    # More than one ref in one push: the ranges do not compose into a single
    # expression, so take the whole-tree scan rather than silently checking one
    # branch and calling it all of them.
    [ "$RANGE_COUNT" -gt 1 ] && CARR_CI_RANGE=""
    export CARR_CI_RANGE

    # WHICH CLASSES THE FLOOR RUNS, decided from the diff (ci-failures council,
    # 2026-08-24). pushfloor carries the diff-scoped predictors; the three named
    # here are whole classes cheap enough to keep local.
    #
    #   secret     — NOT a red-predictor, and kept anyway. The council's table
    #                drops it because it has never failed hosted, which is a
    #                frequency argument; this control exists so a credential does
    #                not reach the remote, and "it has not happened yet" is the
    #                weakest possible reason to remove that. The gates council
    #                before it ruled the opposite way and in as many words —
    #                keep owner, no-main and secrets local no matter what. Range-
    #                scoped it costs about a second. Kept.
    #   freshness  — the council asked for it by name; it is 0s hosted and it
    #                catches a generated file being overwritten from a stale base.
    #   migration  — ONLY when the diff touches migrations/. The class is 33s
    #                hosted and needs a throwaway Postgres, so it SKIPs on a
    #                laptop; adding it unconditionally would buy a skip line.
    #
    # SPACE-SEPARATED, NOT COMMA-SEPARATED, and the separator is the whole bug.
    #
    # ci.sh accepts either — its usage line says "comma- or space-separated" —
    # but it has only accepted COMMAS since the push-floor change that taught
    # `--only` to split them. Before that, `--only` was a plain assignment, so a
    # comma list arrived as ONE token and ci.sh refused it with
    # "no such class: pushfloor,secret,freshness,migration".
    #
    # That skew is not hypothetical and it is not self-healing. THIS HOOK IS
    # ALWAYS CANONICAL'S, because core.hooksPath is one shared path for every
    # worktree on the machine, while ci.sh is resolved from REPO_ROOT — the tree
    # actually being pushed. So a worktree branched from a commit older than that
    # change runs TODAY'S hook against THAT DAY'S ci.sh, and every push from it is
    # refused for a class name that does not exist. Observed 2026-08-26: the
    # refusal reads as a quality failure and tells the caller to iterate on the
    # failing class with `ops/ci.sh --only`, which cannot work, because the class
    # it names is the joined string. The natural next move is CARR_SKIP_CI=1
    # without running anything, which is how a broken hook becomes a habit of
    # skipping the floor.
    #
    # Spaces work on BOTH versions: the old assignment leaves the string intact
    # and ci.sh's `for _want in $ONLY` splits it on whitespace; the new one runs
    # tr over a string with no commas and changes nothing. Verified against both
    # parsers before this was written. Do not "tidy" these back into commas.
    FLOOR_CLASSES="pushfloor secret freshness"
    if [ -n "$CARR_CI_RANGE" ] \
        && git diff --name-only "$CARR_CI_RANGE" 2>/dev/null | grep -q '^migrations/'; then
      FLOOR_CLASSES="$FLOOR_CLASSES migration"
    fi

    if [ -n "$CARR_CI_RANGE" ]; then
      echo "  pre-push: checking $CARR_CI_RANGE — $FLOOR_CLASSES (full strict suite runs hosted)…" >&2
    else
      echo "  pre-push: running $FLOOR_CLASSES (full strict suite runs hosted)…" >&2
    fi
    # STRIP THE HOOK'S GIT ENVIRONMENT BEFORE RUNNING CI, and this is not hygiene —
    # it is the fix for a bug that destroyed local main on 2026-08-14.
    #
    # Git exports GIT_DIR (and usually GIT_INDEX_FILE) to every hook. Those
    # variables OVERRIDE cwd for any child `git` process. CI runs selftests that
    # build throwaway repositories with tempfile.mkdtemp and then call git with
    # cwd set to that temp path — which is correct, sandboxed code, and which git
    # ignored entirely here, because GIT_DIR pointed at the live repository.
    #
    # So every one of those fixture commits landed on the LIVE checkout, on
    # whatever branch happened to be current. The damage, found by a peer session:
    # local main sitting on a commit whose tree held THREE files, six commits ahead
    # of origin, five of them selftest artifacts named "seed", "seed unrelated" and
    # one stamped with the fixture hash +deadbeef, with all 818 paths staged as
    # additions — so any commit from any session would have swept the whole repo
    # under one message. Origin was never touched; recovery was a mixed reset.
    #
    # ONE AMENDMENT from the loop #371 pass. Scrubbing here is the right FIRST
    # line of defence and it stays. But "the selftests were never wrong" does not
    # survive contact: a test that mutates whatever repository invoked it is
    # wrong on its own terms, whoever set the variable. This hook is only ONE way
    # ci.sh is reached — another git hook, a merge driver, `git rebase -x`, or a
    # session that simply has GIT_DIR exported all get to the same selftests
    # without passing through here. So the selftests scrub for themselves now
    # (ops/git_env.py) and this remains the outer layer.
    #
    # THE LIST STAYS LITERAL HERE ON PURPOSE. Sourcing it from
    # `python3 ops/git_env.py --unset-args` was tried and reverted: it defeats
    # ops/hook-env-isolation-selftest.py, which deliberately checks that the
    # stripping and the ci.sh call are ONE statically readable statement, and it
    # puts a python dependency on the push path whose fallback would go stale in
    # silence. A literal list that a test can read beats a clever one it cannot.
    # ops/git-env-selftest.py fails if this list stops covering
    # git_env.GIT_LOCATION_VARS, so the two cannot drift even though the words
    # appear twice.
    # The run is TEE'd so the session still watches it live while the text is
    # also kept for the attribution pass below. A pipeline reports the exit
    # status of its LAST command -- tee's, which is always 0 -- so ci.sh's own
    # status is carried out through a file. Getting this wrong would turn every
    # red push green, which is the one bug this hook must not have.
    # NOT `mktemp -t <prefix>`. That is BSD spelling: macOS appends a random
    # suffix to a bare prefix, GNU coreutils REQUIRES the template to contain
    # XXXXXX and errors out without it. This hook runs on Joe's Mac and its
    # selftest runs on an ubuntu runner, so the BSD-only form worked locally and
    # failed hosted -- CI_LOG came back empty, `cat ""` returned 1, and the hook
    # refused every push including the green ones. An explicit template with
    # XXXXXX is the one spelling both implementations read the same way.
    CI_LOG="$(mktemp "${TMPDIR:-/tmp}/carr-prepush-log.XXXXXX")"
    CI_RC_FILE="$(mktemp "${TMPDIR:-/tmp}/carr-prepush-rc.XXXXXX")"
    {
      env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
          -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
          -u GIT_COMMON_DIR -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES \
          -u GIT_WORK_TREE_OVERRIDE -u GIT_CONFIG -u GIT_CONFIG_GLOBAL \
          -u GIT_CONFIG_SYSTEM -u GIT_CONFIG_COUNT \
          sh -c 'exec "$0" --only "$1"' "$REPO_ROOT/ops/ci.sh" "$FLOOR_CLASSES"
      echo $? > "$CI_RC_FILE"
    } 2>&1 | tee "$CI_LOG" >&2
    CI_RC="$(cat "$CI_RC_FILE" 2>/dev/null || echo 1)"
    rm -f "$CI_RC_FILE"
    if [ "$CI_RC" -ne 0 ]; then
      cat >&2 <<'EOF'

  ────────────────────────────────────────────────────────────────
  PUSH REFUSED — carr-system quality checks failed
  ────────────────────────────────────────────────────────────────
  The failing class is named above. Run it on its own to iterate:

      ops/ci.sh --only <class>
      ops/ci.sh --list

  This is the LOCAL FLOOR — the classes the diff implicates, scoped to
  what this push changes. The full strict suite runs hosted and is the
  gate on the merge. The floor exists because the classes that actually
  go red (types, gates) are the ones cheapest to catch right here.

  Each failing check above names its own remedy.

  Fix it. A skip is not printed here on purpose (bypass audit item 10,
  2026-09-24): CARR_SKIP_CI=1 still exists, but only with a non-empty
  CARR_SKIP_CI_REASON, and it now leaves a receipt in
  out/ci-skip-receipts.jsonl -- it is not the obvious next line to paste.

EOF
      # WHOSE FILE IS IT? A refusal that names a path and stops there is one a
      # session on this machine cannot act on: thirty-five worktrees share one
      # canonical checkout, and on 2026-08-09 the cost of guessing wrong was
      # another session's work deleted. So any path this failure named that
      # belongs to somebody ELSE is attributed here by name.
      #
      # A REPORTER, NOT A GATE. It runs only on a failure that already happened,
      # it cannot change the outcome, and if it breaks the refusal above still
      # stands on its own -- which is why its output is best-effort and its own
      # exit status is discarded.
      if [ -x "$REPO_ROOT/ops/worktree-attribution.py" ] \
          && command -v python3 >/dev/null 2>&1; then
        MINE="$(basename "$REPO_ROOT")"
        FOREIGN="$(grep -oE '[A-Za-z0-9_./-]+\.[A-Za-z0-9]+' "$CI_LOG" 2>/dev/null \
                   | sort -u | head -40 \
                   | xargs -r python3 "$REPO_ROOT/ops/worktree-attribution.py" \
                     --porcelain 2>/dev/null \
                   | awk -F'\t' -v me="$MINE" '$2 != "unknown" && $3 != me && $3 != "-"')"
        if [ -n "$FOREIGN" ]; then
          echo "  Some of those paths are not this worktree's:" >&2
          printf '%s\n' "$FOREIGN" \
            | awk -F'\t' '{printf "      %s\n          belongs to session %s (%s)\n", $1, $3, $4}' >&2
          echo >&2
          echo "  Do not delete or revert those — ask that session, or read its branch." >&2
          echo >&2
        fi
      fi
      echo "  ────────────────────────────────────────────────────────────────" >&2
      echo >&2
      rm -f "$CI_LOG"
      exit 1
    fi
    rm -f "$CI_LOG"
  fi
fi

# ── WHAT THIS CHANGE OWES ─────────────────────────────────────────────────
# Advisory only, and it can never refuse a push. Hosted CI on one branch
# refused three times on 2026-09-18 and not one refusal was about whether the
# code worked: each was a toll this repository charges for a KIND of change --
# a seal derived before the last edit, a branch left conflicting so the pull
# request drew zero checks, a derived file resolved by picking a side. All
# three are readable off the changed-file list, and all three were missed
# because catching them depended on a session remembering nine separate
# lessons at the moment it typed git push.
#
# IT NOW HOLDS A PUSH, AND THE MODEL STILL DOES NOT DECIDE ANYTHING.
#
# The first version printed and returned zero on every path. On 2026-09-18 it
# scored `inventory_reseal` at 0.94 on a push, in the session's own terminal,
# naming the exact remedy -- and the session pushed anyway. Hosted CI failed
# 25 minutes later on precisely that. The judgment was not missing, not wrong
# and not quiet. It had no consequence attached, and a warning with no
# consequence is a warning that gets read past.
#
# WHAT CHANGED IS NOT THAT A PROBABILITY CAN NOW REFUSE A PUSH. It cannot,
# and the rule that judgment advises beside the deterministic layer rather
# than deciding inside it is intact. The model chooses WHICH DETERMINISTIC
# CHECK IS WORTH RUNNING; that check's own exit code decides. A push is
# refused by the seal assertion, by gate-integrity, by the wiring selftest --
# never by a score.
#
# WHAT A WRONG JUDGMENT COSTS, which is the whole reason this is safe: a
# false positive runs a check that passes. This advisory has scored
# `gate_rebless` at 0.71 on changes owing no rebless; under this design that
# buys a sub-second run of gate-integrity.py and nothing else. The full
# verification pass over a clean tree measured 3.7 seconds. Against a failed
# hosted cycle at 25 to 40 minutes, the trade is not close.
#
# EVERY OTHER PATH STILL RETURNS ZERO. No credential, no network, no service,
# an exception anywhere, a verifier that cannot be launched -- all of those
# pass the push through untouched. The only thing that stops a push here is a
# deterministic check that ran and failed.
#
# CARR_SKIP_TOLL_ADVISORY still skips the whole block, deliberately: a door
# with no handle gets taken off its hinges.
if [ -z "$CARR_SKIP_TOLL_ADVISORY" ] && [ -f "$REPO_ROOT/ops/jev_change_tolls.py" ]; then
  # NOT 2>/dev/null. The advisory writes to stderr, so silencing stderr wired
  # it to a door and made it invisible in the same commit -- the exact failure
  # this session built ops/judgment-wiring-selftest.py to catch, committed by
  # the person who built it. The block below catches every exception itself and
  # exits 0, so there is nothing left to suppress.
  # NOT 2>/dev/null. The advisory writes to stderr, so silencing stderr wired
  # it to a door and made it invisible in the same commit -- the exact failure
  # this session built ops/judgment-wiring-selftest.py to catch, committed by
  # the person who built it.
  #
  # Exit 3 is this block's own refusal, kept distinct from the deterministic
  # classes above so a reader can tell them apart at a glance.
  # The verifier can launch Git-backed selftests. The CI block above strips
  # Git's hook variables, and this second child needs the same isolation:
  # otherwise a fixture's git init can change the shared checkout's .git/config.
  env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
      -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
      -u GIT_COMMON_DIR -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES \
      -u GIT_WORK_TREE_OVERRIDE -u GIT_CONFIG -u GIT_CONFIG_GLOBAL \
      -u GIT_CONFIG_SYSTEM -u GIT_CONFIG_COUNT \
      REPO_ROOT="$REPO_ROOT" "$REPO_ROOT/.venv/bin/python" - <<'TOLLS'
import importlib.util, os, sys
root = os.environ.get("REPO_ROOT") or os.getcwd()
try:
    spec = importlib.util.spec_from_file_location(
        "jev_change_tolls", os.path.join(root, "ops", "jev_change_tolls.py"))
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    state = module.change(repo=root)
    rows = module.owed(state)
    failures = module.verify(state, repo=root)
except Exception:
    # Unreachable service, missing credential, malformed answer: the push is
    # not this check's to refuse when the check itself could not run.
    sys.exit(0)

if rows:
    print("\n  WHAT THIS CHANGE LOOKS LIKE IT OWES:", file=sys.stderr)
    for probability, name, fix in rows:
        mark = "UNPAID" if any(f[0] == name for f in failures) else "ok"
        print(f"    {probability:.2f}  {name}  [{mark}]", file=sys.stderr)
        print(f"          {fix}", file=sys.stderr)
    print("", file=sys.stderr)

if failures:
    print("  PUSH HELD. These are not predictions -- each is a deterministic",
          file=sys.stderr)
    print("  check that RAN against this tree and FAILED:\n", file=sys.stderr)
    for name, probability, reason, output in failures:
        print(f"    {name}: {reason}", file=sys.stderr)
        for line in (output or "").strip().splitlines()[-6:]:
            print(f"        {line}", file=sys.stderr)
        print("", file=sys.stderr)
    print("  Pay the toll above and push again. Nothing here is a judgment",
          file=sys.stderr)
    print("  call: fix the check and it goes green. To push regardless, set",
          file=sys.stderr)
    print("  CARR_SKIP_TOLL_ADVISORY=1 and say in the commit why.\n",
          file=sys.stderr)
    sys.exit(3)
TOLLS
  status=$?
  if [ "$status" -eq 3 ]; then
    exit 1
  fi
fi

# The two REPORTERS below run on every push that got this far. Neither can
# change the outcome, so no exit sits above them: until 2026-09-30 a bare
# `exit 0` here left the client-name note unreachable from the day it landed.
# ops/pr-size-check-selftest.py fails if a top-level exit returns above them.

# ---------------------------------------------------------------------------
# CLIENT-NAME NOTE, a REPORTER and not a gate (decision 4d6ce1c7, 2026-09-24).
# Joe: no bulk scrub and no history rewrite; new lines should ideally carry no
# client name, and old ones convert gradually as they are touched. This prints
# file:line for any line the branch ADDS against main that carries a name from
# the gitignored local list, never the name itself, and a one-line reminder to
# swap in a pseudonym. It never changes the push's outcome: its exit status is
# discarded, it is silent when the local list is absent, and it has no CI step.
# ---------------------------------------------------------------------------
if [ -n "$REPO_ROOT" ] && [ -f "$REPO_ROOT/ops/githooks/client-name-warn.py" ] \
    && command -v python3 >/dev/null 2>&1; then
  python3 "$REPO_ROOT/ops/githooks/client-name-warn.py" "origin/main...HEAD" "$REPO_ROOT" || true
fi

# ---------------------------------------------------------------------------
# DECOMPOSITION NOTE, a REPORTER and not a gate (engineering-workflow-sop
# section 15, small incremental changes). Over 300 changed lines or 5 files
# outside generated paths, or moves mixed with edits, prints a short split
# suggestion. Silent otherwise; exit status discarded; Git's hook variables
# stripped so its git calls read this checkout and nothing else.
# ---------------------------------------------------------------------------
if [ -n "$REPO_ROOT" ] && [ -f "$REPO_ROOT/ops/pr-size-check.py" ] \
    && command -v python3 >/dev/null 2>&1; then
  env -u GIT_DIR -u GIT_INDEX_FILE -u GIT_WORK_TREE -u GIT_PREFIX \
      -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
      -u GIT_COMMON_DIR -u GIT_NAMESPACE -u GIT_CEILING_DIRECTORIES \
      python3 "$REPO_ROOT/ops/pr-size-check.py" "origin/main...HEAD" "$REPO_ROOT" || true
fi
exit 0
