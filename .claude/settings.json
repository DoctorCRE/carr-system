{
  "autoCompactEnabled": true,
  "autoCompactWindow": 500000,
  "autoMemoryEnabled": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Bash|mcp__t3-code__delegate_task|mcp__t3-code__t3_thread_launch|mcp__t3-code__create_threads|mcp__t3-code__t3_thread_send|mcp__t3-code__schedule_task|mcp__t3-code__run_scheduled_task_now|mcp__t3-code__t3_pending_request|mcp__t3-code__t3_queue|mcp__t3-code__t3_thread_send_attachments",
        "hooks": [
          {
            "type": "command",
            "command": "r=\"${HOME}/carr-system\"; [ -f \"$r/hooks/agent-card-gate.py\" ] || r=\"${CLAUDE_PROJECT_DIR:-}\"; if [ ! -f \"$r/hooks/agent-card-gate.py\" ]; then printf '%s\\n' \"CARR HOOK WARNING: missing script $r/hooks/agent-card-gate.py; skipping\" >&2; exit 0; fi; exec /usr/bin/env python3 \"$r/hooks/agent-card-gate.py\"",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -d \"${HOME}/carr-system/hooks\" ] || exit 0; if [ ! -e \"${HOME}/carr-system/hooks/worktree-self-plumb.py\" ] && [ ! -L \"${HOME}/carr-system/hooks/worktree-self-plumb.py\" ]; then printf '%s\\n' \"CARR HOOK WARNING: missing script ${HOME}/carr-system/hooks/worktree-self-plumb.py; skipping\" >&2; exit 0; fi; exec /usr/bin/env python3 \"${HOME}/carr-system/hooks/worktree-self-plumb.py\"",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "[ -d \"${HOME}/carr-system/hooks\" ] || exit 0; if [ ! -e \"${HOME}/carr-system/hooks/machine-converge.py\" ] && [ ! -L \"${HOME}/carr-system/hooks/machine-converge.py\" ]; then printf '%s\\n' \"CARR HOOK WARNING: missing script ${HOME}/carr-system/hooks/machine-converge.py; skipping\" >&2; exit 0; fi; exec /usr/bin/env python3 \"${HOME}/carr-system/hooks/machine-converge.py\"",
            "timeout": 180
          },
          {
            "type": "command",
            "command": "[ -d \"${HOME}/carr-system/hooks\" ] || exit 0; if [ ! -e \"${HOME}/carr-system/hooks/team-memory-index.py\" ] && [ ! -L \"${HOME}/carr-system/hooks/team-memory-index.py\" ]; then printf '%s\\n' \"CARR HOOK WARNING: missing script ${HOME}/carr-system/hooks/team-memory-index.py; skipping\" >&2; exit 0; fi; exec /usr/bin/env python3 \"${HOME}/carr-system/hooks/team-memory-index.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  },
