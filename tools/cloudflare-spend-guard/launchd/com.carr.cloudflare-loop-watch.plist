<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- HELD: not installed and not loaded. Activation waits for review of the Cloudflare spend guard PR. -->
  <!-- Once a minute, never respawned: no KeepAlive, RunAtLoad false. launchd starts one instance at a time; -->
  <!-- a firing that comes while the previous run is alive is missed (man launchd.plist), and the run's own -->
  <!-- non-blocking lock and 10 s self-alarm cover the rest. -->
  <!-- StartCalendarInterval, not StartInterval: lib/launchd_calendar.py records StartInterval agents sitting at -->
  <!-- runs = 0 on the Studio (macOS 27). Render with {{REPO}} replaced by the checkout path. -->
  <key>Label</key><string>com.carr.cloudflare-loop-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{REPO}}/.venv/bin/python</string>
    <string>{{REPO}}/tools/cloudflare_loop_watch.py</string>
    <string>scan</string>
  </array>
  <key>WorkingDirectory</key><string>{{REPO}}</string>
  <!-- carr-launchd-interval-seconds: 60 | rendered by lib/launchd_calendar.py -->
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Minute</key><integer>0</integer></dict>
    <dict><key>Minute</key><integer>1</integer></dict>
