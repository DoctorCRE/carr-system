---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef works fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef wrong fill:#fdedec,stroke:#c0392b,color:#7b241c
  classDef fixed fill:#e9f7ef,stroke:#1e8449,color:#145a32
  classDef worksPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef wrongPath fill:#fdedec,stroke:#1f3a93,stroke-width:4px,color:#7b241c
  classDef fixedPath fill:#e9f7ef,stroke:#1f3a93,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Works" as legendWorks
  }
  class legendWorks works
  state "Read alert | Inbox card |<br/>Work still open" as s0
  state "Read alert | Settled card<br/>| Work still open" as s1
  state "Read alert | Snoozed card<br/>| Work still open" as s2
  state "Unread alert | Inbox card<br/>| Work still open" as s3
  state "Unread alert | Settled<br/>card | Work still open" as s4
  state "Unread alert | Snoozed<br/>card | Work still open" as s5
  [*] --> s3
  s3 --> s0 : Read the alert
  s3 --> s4 : Settle the card
  s3 --> s5 : Snooze the card
  s0 --> s1 : Settle the card
  s0 --> s2 : Snooze the card
  class s0 works
  class s1 works
  class s2 works
  class s3 works
  class s4 works
  class s5 works
