---- MODULE DealDocumentText ----
\* Generated by chart-to-tla.mjs from J79-retention2.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart J79-retention2.mmd keeps it, checks it, and compares it with the chart.

VARIABLES lifecycle, viewer
vars == <<lifecycle, viewer>>

\* Region Lifecycle
lifecycleStates == {"Absent", "Deleted", "Produced", "Superseded", "Unavailable"}
\* Region Viewer
viewerStates == {"Readable", "Unreadable"}

TypeOK ==
    /\ lifecycle \in lifecycleStates
    /\ viewer \in viewerStates

Init ==
    /\ lifecycle = "Absent"
    /\ viewer = "Unreadable"

\* Text layer retained
TextLayerRetained ==
    /\ (lifecycle \in {"Absent"})
    /\ \/ (lifecycle = "Absent" /\ lifecycle' = "Produced")
       \/ (lifecycle \notin {"Absent"} /\ UNCHANGED lifecycle)
    /\ \/ (viewer = "Unreadable" /\ viewer' = "Readable")
       \/ (viewer \notin {"Unreadable"} /\ UNCHANGED viewer)

\* No extractable text
NoExtractableText ==
    /\ (lifecycle \in {"Absent"})
    /\ \/ (lifecycle = "Absent" /\ lifecycle' = "Unavailable")
       \/ (lifecycle \notin {"Absent"} /\ UNCHANGED lifecycle)
    /\ \/ (viewer = "Unreadable" /\ viewer' = "Unreadable")
       \/ (viewer \notin {"Unreadable"} /\ UNCHANGED viewer)

\* Same source retried
SameSourceRetried ==
    /\ (lifecycle \in {"Produced", "Unavailable"})
    /\ \/ (lifecycle = "Produced" /\ lifecycle' = "Produced")
       \/ (lifecycle = "Unavailable" /\ lifecycle' = "Unavailable")
       \/ (lifecycle \notin {"Produced", "Unavailable"} /\ UNCHANGED lifecycle)
    /\ \/ (viewer = "Readable" /\ viewer' = "Readable")
       \/ (viewer = "Unreadable" /\ viewer' = "Unreadable")
       \/ (viewer \notin {"Readable", "Unreadable"} /\ UNCHANGED viewer)

\* Original bytes replaced
OriginalBytesReplaced ==
    /\ (lifecycle \in {"Produced", "Unavailable"})
    /\ \/ (lifecycle = "Produced" /\ lifecycle' = "Superseded")
       \/ (lifecycle = "Unavailable" /\ lifecycle' = "Superseded")
       \/ (lifecycle \notin {"Produced", "Unavailable"} /\ UNCHANGED lifecycle)
    /\ \/ (viewer = "Readable" /\ viewer' = "Unreadable")
       \/ (viewer = "Unreadable" /\ viewer' = "Unreadable")
       \/ (viewer \notin {"Readable", "Unreadable"} /\ UNCHANGED viewer)

\* New text retained
NewTextRetained ==
    /\ (lifecycle \in {"Superseded"})
    /\ \/ (lifecycle = "Superseded" /\ lifecycle' = "Produced")
       \/ (lifecycle \notin {"Superseded"} /\ UNCHANGED lifecycle)
    /\ \/ (viewer = "Unreadable" /\ viewer' = "Readable")
       \/ (viewer \notin {"Unreadable"} /\ UNCHANGED viewer)

\* New source has no text
NewSourceHasNoText ==
    /\ (lifecycle \in {"Superseded"})
    /\ \/ (lifecycle = "Superseded" /\ lifecycle' = "Unavailable")
       \/ (lifecycle \notin {"Superseded"} /\ UNCHANGED lifecycle)
    /\ \/ (viewer = "Unreadable" /\ viewer' = "Unreadable")
       \/ (viewer \notin {"Unreadable"} /\ UNCHANGED viewer)

\* Attachment removed
AttachmentRemoved ==
    /\ (lifecycle \in {"Absent", "Produced", "Unavailable", "Superseded"})
    /\ \/ (lifecycle = "Absent" /\ lifecycle' = "Deleted")
       \/ (lifecycle = "Produced" /\ lifecycle' = "Deleted")
       \/ (lifecycle = "Unavailable" /\ lifecycle' = "Deleted")
       \/ (lifecycle = "Superseded" /\ lifecycle' = "Deleted")
       \/ (lifecycle \notin {"Absent", "Produced", "Unavailable", "Superseded"} /\ UNCHANGED lifecycle)
    /\ \/ (viewer = "Readable" /\ viewer' = "Unreadable")
       \/ (viewer = "Unreadable" /\ viewer' = "Unreadable")
       \/ (viewer \notin {"Readable", "Unreadable"} /\ UNCHANGED viewer)

Next == TextLayerRetained \/ NoExtractableText \/ SameSourceRetried \/ OriginalBytesReplaced \/ NewTextRetained \/ NewSourceHasNoText \/ AttachmentRemoved

Spec == Init /\ [][Next]_vars

\* Deleted attachments cannot be read
NoDeletedText == ~(lifecycle = "Deleted" /\ viewer = "Readable")

\* Old text cannot serve changed original bytes
NoStaleText == ~(lifecycle = "Superseded" /\ viewer = "Readable")

\* Missing derivatives cannot claim text
NoAbsentText == ~(lifecycle = "Absent" /\ viewer = "Readable")

\* Missing text layers cannot claim text
NoUnavailableText == ~(lifecycle = "Unavailable" /\ viewer = "Readable")

