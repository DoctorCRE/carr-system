---- MODULE PushRegistry ----
\* Generated by chart-to-tla.mjs from registry.mmd.
\* Each region is one variable and each transition label is one action.
\* Once you add guards and variables from the real code, this file is the source.
\* statechart.mjs from-chart registry.mmd keeps it, checks it, and compares it with the chart.

VARIABLES subscription, authentication
vars == <<subscription, authentication>>

\* Region Subscription
subscriptionStates == {"Active", "Off", "Revoked"}
\* Region Authentication
authenticationStates == {"SignedIn", "SignedOut"}

TypeOK ==
    /\ subscription \in subscriptionStates
    /\ authentication \in authenticationStates

Init ==
    /\ subscription = "Off"
    /\ authentication = "SignedIn"

\* Register
Register ==
    /\ authentication = "SignedIn"
    /\ \/ (subscription = "Off" /\ subscription' = "Active")
    /\ UNCHANGED <<authentication>>

\* Replace
Replace ==
    /\ authentication = "SignedIn"
    /\ \/ (subscription = "Active" /\ subscription' = "Active")
    /\ UNCHANGED <<authentication>>

\* Revoke
Revoke ==
    /\ authentication = "SignedIn"
    /\ \/ (subscription = "Active" /\ subscription' = "Revoked")
    /\ UNCHANGED <<authentication>>

\* Enable
Enable ==
    /\ authentication = "SignedIn"
    /\ \/ (subscription = "Revoked" /\ subscription' = "Active")
    /\ UNCHANGED <<authentication>>

\* Logout
Logout ==
    /\ (subscription \in {"Active", "Off", "Revoked"} \/ authentication \in {"SignedIn"})
    /\ \/ (subscription = "Active" /\ subscription' = "Revoked")
       \/ (subscription = "Off" /\ subscription' = "Off")
       \/ (subscription = "Revoked" /\ subscription' = "Revoked")
       \/ (subscription \notin {"Active", "Off", "Revoked"} /\ UNCHANGED subscription)
    /\ \/ (authentication = "SignedIn" /\ authentication' = "SignedOut")
       \/ (authentication \notin {"SignedIn"} /\ UNCHANGED authentication)

Next == Register \/ Replace \/ Revoke \/ Enable \/ Logout

Spec == Init /\ [][Next]_vars

\* logout prevents registration through the old session
NoActiveAfterLogout == ~(subscription = "Active" /\ authentication = "SignedOut")

====
