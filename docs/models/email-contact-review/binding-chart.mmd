---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef works fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef wrong fill:#fdedec,stroke:#c0392b,color:#7b241c
  classDef fixed fill:#e9f7ef,stroke:#1e8449,color:#145a32
  classDef worksPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef wrongPath fill:#fdedec,stroke:#1f3a93,stroke-width:4px,color:#7b241c
  classDef fixedPath fill:#e9f7ef,stroke:#1f3a93,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Works" as legendWorks
  }
  class legendWorks works
  state "Held, changed snapshot" as s0
  state "Held, current snapshot" as s1
  state "Prepared, changed snapshot" as s2
  state "Prepared, current snapshot" as s3
  state "Recorded, current snapshot" as s4
  [*] --> s3
  s3 --> s2 : contact identity changes
  s3 --> s4 : submit observed signature
  s2 --> s3 : contact identity changes
  s2 --> s0 : submit observed signature
  s0 --> s1 : contact identity changes
  s0 --> s3 : observe the current contact
  s1 --> s0 : contact identity changes
  s1 --> s3 : observe the current contact
  class s0 works
  class s1 works
  class s2 works
  class s3 works
  class s4 works
