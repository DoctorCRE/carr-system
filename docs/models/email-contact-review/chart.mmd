---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef works fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef wrong fill:#fdedec,stroke:#c0392b,color:#7b241c
  classDef fixed fill:#e9f7ef,stroke:#1e8449,color:#145a32
  classDef worksPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef wrongPath fill:#fdedec,stroke:#1f3a93,stroke-width:4px,color:#7b241c
  classDef fixedPath fill:#e9f7ef,stroke:#1f3a93,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Works" as legendWorks
  }
  class legendWorks works
  state "At the same time" as regions {
    [*] --> r0s1
    state "keyed" as r0s0
    state "keyless" as r0s1
    r0s1 --> r0s0 : prove decoder alias by<br/>unambiguous Message-ID
    --
    [*] --> r1s6
    state "Changed" as r1s0
    state "Held" as r1s1
    state "Prepared" as r1s2
    state "Recorded" as r1s3
    state "Refused" as r1s4
    state "Retry" as r1s5
    state "Unread" as r1s6
    r1s0 --> r1s5 : original source binding<br/>restored
    r1s1 --> r1s6 : read full source with exact<br/>party
    r1s2 --> r1s5 : submit frozen proposal
    r1s2 --> r1s3 : submit frozen proposal
    r1s2 --> r1s4 : submit frozen proposal
    r1s5 --> r1s0 : retry or hold after validation
    r1s6 --> r1s1 : resolve sender and inspect<br/>signature
    r1s6 --> r1s2 : resolve sender and inspect<br/>signature
  }
  class r0s0 works
  class r0s1 works
  class r1s0 works
  class r1s1 works
  class r1s2 works
  class r1s3 works
  class r1s4 works
  class r1s5 works
  class r1s6 works
