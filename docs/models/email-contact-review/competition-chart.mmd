---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef works fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef wrong fill:#fdedec,stroke:#c0392b,color:#7b241c
  classDef fixed fill:#e9f7ef,stroke:#1e8449,color:#145a32
  classDef worksPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef wrongPath fill:#fdedec,stroke:#1f3a93,stroke-width:4px,color:#7b241c
  classDef fixedPath fill:#e9f7ef,stroke:#1f3a93,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Works" as legendWorks
  }
  class legendWorks works
  state "Checking returning<br/>signature" as s0
  state "Competing signatures held" as s1
  state "Distinct sources proven" as s2
  state "Original proposal retained" as s3
  [*] --> s3
  s3 --> s1 : Read two indistinguishable<br/>keyed signatures
  s1 --> s0 : Read one signature again
  s1 --> s2 : Read distinguishing evidence<br/>for the other source
  s0 --> s1 : Check retained evidence
  s2 --> s0 : Read one signature again
  s0 --> s2 : Check retained evidence
  class s0 works
  class s1 works
  class s2 works
  class s3 works
