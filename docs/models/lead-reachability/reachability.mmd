stateDiagram-v2
 state Snapshot {
  state Evidence {
    [*] --> Unknown
    Unknown --> Current: sourced finding recorded
    Current --> Expired: evidence expires
    Current --> Conflicting: discrepancy recorded
    Conflicting --> Current: discrepancy expires
    Expired --> Current: fresh finding recorded
    Current --> Unknown: evidence removed
  }
  --
  state Eligibility {
    [*] --> Eligible
    Eligible --> Restricted: contact restricted
    Restricted --> Eligible: restriction lifted
  }
  --
  state Classification {
    [*] --> Research
    Research --> Research: snapshot refreshed
  }
 }
  %% never NoUnsupportedReachable: Reachable -- Free form identity findings cannot establish a verified usable route.
