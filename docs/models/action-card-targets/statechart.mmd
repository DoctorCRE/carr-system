---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  classDef works fill:#f4f6f7,stroke:#566573,color:#1b2631
  classDef wrong fill:#fdedec,stroke:#c0392b,color:#7b241c
  classDef fixed fill:#e9f7ef,stroke:#1e8449,color:#145a32
  classDef worksPath fill:#f4f6f7,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef wrongPath fill:#fdedec,stroke:#1f3a93,stroke-width:4px,color:#7b241c
  classDef fixedPath fill:#e9f7ef,stroke:#1f3a93,stroke-width:4px,color:#145a32
  state "Legend" as legend {
    state "Works" as legendWorks
  }
  class legendWorks works
  state "Resolved" as g0 {
    state "card visible; no<br/>operations" as s0
    state "card visible; review<br/>available" as s1
  }
  state "Foreign: no private<br/>detail; no operations" as s2
  state "Missing: no private<br/>detail; no operations" as s3
  state "Requested: no private<br/>detail; no operations" as s4
  state "Retired: no private<br/>detail; no operations" as s5
  state "Stale: card visible; no<br/>operations" as s6
  [*] --> s4
  s4 --> s1 : Owner opens current source
  s4 --> s2 : Other partner opens source
  s4 --> s3 : Unknown or deleted source
  s1 --> s6 : Source changes
  s1 --> s5 : Source retires
  s1 --> s0 : Review completed
  class s2 works
  class s3 works
  class s4 works
  class s0 works
  class s1 works
  class s5 works
  class s6 works
