{
  "type": "array",
  "minItems": 1,
  "maxItems": 100,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "start_month": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12000
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "required": [
          "value",
          "source"
        ]
      },
      "end_month": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12000
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "required": [
          "value",
          "source"
        ]
      },
      "rate": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,29})(\\.[0-9]{1,18})?$"
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "required": [
          "value",
          "source"
        ]
      },
      "unit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "enum": [
              "USD/SF/year",
              "USD/SF/month"
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "required": [
          "value",
          "source"
        ]
      },
      "expense_basis": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "enum": [
              "nnn",
              "modified_gross",
              "full_service_gross",
              "gross"
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "required": [
          "value",
          "source"
        ]
      },
      "escalation_percent": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "value": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,29})(\\.[0-9]{1,18})?$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "#/$defs/source"
          }
        },
        "required": [
          "value",
          "source"
        ]
      }
    },
    "required": [
      "start_month",
      "end_month",
      "rate",
      "unit",
      "expense_basis",
      "escalation_percent"
    ]
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "region_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "method": {
          "enum": [
            "text_layer",
            "ocr"
          ]
        }
      },
      "required": [
        "page",
        "region_id",
        "method"
      ]
    }
  }
}
